diff --git a/styles/perception.css b/styles/perception.css
new file mode 100644
index 0000000..d203155
--- /dev/null
+++ b/styles/perception.css
@@ -0,0 +1,291 @@
+/* ── 感知系统：设置与诊断面板 ─────────────────────
+   与工坊（qa.css）同一套设计语言：浅色卡片、柔和阴影、紫色强调。
+   全部变量 scope 在 .per-shell 内，不污染全局。
+
+   布局说明：本面板是**嵌在设置页 page-body 内**渲染的（与 CallOverlaySettings
+   同一挂载方式），所以不能用 position:absolute 自撑全屏——那样会盖住设置页的
+   标题栏。改用普通文档流，滚动交给设置页的 page-body。 */
+
+.per-shell {
+  --per-accent: #6f5bd6;
+  --per-accent-soft: rgba(111, 91, 214, 0.12);
+  --per-ok: #34c759;
+  --per-warn: #ff9f0a;
+  --per-off: #a0a3a8;
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  color: var(--c-text-title);
+}
+
+/* ── 状态总览卡 ── */
+.per-hero {
+  margin: 0 0 4px;
+  padding: 16px 18px;
+  border-radius: 16px;
+  background: var(--c-panel);
+  box-shadow: 0 6px 20px rgba(40, 34, 20, 0.06);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.per-hero-head {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.per-hero-title {
+  flex: 1;
+  min-width: 0;
+  font-size: calc(15px * var(--app-text-scale, 1));
+  font-weight: 700;
+}
+
+.per-state {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 10px;
+  border-radius: 999px;
+  font-size: calc(11.5px * var(--app-text-scale, 1));
+  font-weight: 600;
+  background: color-mix(in srgb, var(--per-off) 12%, transparent);
+  color: var(--per-off);
+  white-space: nowrap;
+}
+.per-state[data-tone="on"] { background: color-mix(in srgb, var(--per-ok) 14%, transparent); color: var(--per-ok); }
+.per-state[data-tone="warn"] { background: color-mix(in srgb, var(--per-warn) 14%, transparent); color: var(--per-warn); }
+
+.per-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 999px;
+  background: currentColor;
+  flex: 0 0 auto;
+}
+.per-dot.is-pulse { animation: per-pulse 2s ease-in-out infinite; }
+@keyframes per-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.35; }
+}
+
+/* 概览数字：一眼看到「今天发生了多少」 */
+.per-metrics {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 8px;
+}
+.per-metric {
+  padding: 9px 10px;
+  border-radius: 11px;
+  background: var(--c-page-body-bg);
+  text-align: center;
+}
+.per-metric-value {
+  font-size: calc(17px * var(--app-text-scale, 1));
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  line-height: 1.1;
+}
+.per-metric-label {
+  margin-top: 3px;
+  font-size: calc(10px * var(--app-text-scale, 1));
+  color: var(--c-text);
+}
+
+.per-note {
+  font-size: calc(11.5px * var(--app-text-scale, 1));
+  line-height: 1.6;
+  color: var(--c-text);
+}
+.per-note.is-warn { color: var(--per-warn); }
+
+/* ── 能力列表 ── */
+.per-cap {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  padding: 13px 16px;
+}
+.per-cap + .per-cap {
+  border-top: 1px solid color-mix(in srgb, var(--c-card-border) 20%, transparent);
+}
+
+.per-cap-icon {
+  width: 32px;
+  height: 32px;
+  flex: 0 0 auto;
+  display: grid;
+  place-items: center;
+  border-radius: 9px;
+  background: var(--per-accent-soft);
+  color: var(--per-accent);
+}
+.per-cap[data-available="false"] .per-cap-icon {
+  background: color-mix(in srgb, var(--per-off) 12%, transparent);
+  color: var(--per-off);
+}
+
+.per-cap-body { flex: 1; min-width: 0; }
+.per-cap-name {
+  font-size: calc(13.5px * var(--app-text-scale, 1));
+  font-weight: 600;
+}
+.per-cap-desc {
+  margin-top: 3px;
+  font-size: calc(11px * var(--app-text-scale, 1));
+  line-height: 1.5;
+  color: var(--c-text);
+}
+
+/* 三重状态徽章：用户开关 / 原生支持 / 前置条件 —— 卡在哪一环一眼可见 */
+.per-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+  margin-top: 7px;
+}
+.per-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 7px;
+  border-radius: 5px;
+  font-size: calc(10px * var(--app-text-scale, 1));
+  font-weight: 600;
+  background: var(--c-page-body-bg);
+  color: var(--c-text);
+}
+.per-tag[data-tone="ok"] { background: color-mix(in srgb, var(--per-ok) 13%, transparent); color: var(--per-ok); }
+.per-tag[data-tone="warn"] { background: color-mix(in srgb, var(--per-warn) 13%, transparent); color: var(--per-warn); }
+.per-tag[data-tone="off"] { background: color-mix(in srgb, var(--per-off) 14%, transparent); color: var(--per-off); }
+
+.per-cap-toggle { flex: 0 0 auto; align-self: center; }
+
+/* ── 参数区 ── */
+.per-field {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 16px;
+}
+.per-field + .per-field {
+  border-top: 1px solid color-mix(in srgb, var(--c-card-border) 20%, transparent);
+}
+.per-field-body { flex: 1; min-width: 0; }
+.per-field-label {
+  font-size: calc(13px * var(--app-text-scale, 1));
+  font-weight: 500;
+}
+.per-field-hint {
+  margin-top: 3px;
+  font-size: calc(10.5px * var(--app-text-scale, 1));
+  line-height: 1.5;
+  color: var(--c-text);
+}
+.per-field-input {
+  width: 84px;
+  flex: 0 0 auto;
+  padding: 8px 10px;
+  border-radius: 10px;
+  border: 1px solid var(--c-input-border);
+  background: var(--c-input);
+  color: var(--c-text-title);
+  font-size: calc(13px * var(--app-text-scale, 1));
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+  outline: none;
+}
+.per-field-input:focus { border-color: var(--per-accent); }
+
+/* ── 流水时间轴 ── */
+.per-log { display: flex; flex-direction: column; padding: 4px 16px 8px; }
+.per-log-item {
+  position: relative;
+  padding: 9px 0 9px 18px;
+}
+/* 竖线：最后一条不画，避免拖尾 */
+.per-log-item::before {
+  content: "";
+  position: absolute;
+  left: 4px;
+  top: 20px;
+  bottom: -2px;
+  width: 1px;
+  background: color-mix(in srgb, var(--c-card-border) 60%, transparent);
+}
+.per-log-item:last-child::before { display: none; }
+.per-log-item::after {
+  content: "";
+  position: absolute;
+  left: 1px;
+  top: 15px;
+  width: 7px;
+  height: 7px;
+  border-radius: 999px;
+  background: var(--per-accent);
+}
+.per-log-item[data-skipped="true"]::after { background: var(--per-off); }
+
+.per-log-head {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+.per-log-type {
+  font-size: calc(12.5px * var(--app-text-scale, 1));
+  font-weight: 600;
+}
+.per-log-time {
+  margin-left: auto;
+  font-size: calc(10px * var(--app-text-scale, 1));
+  color: var(--c-text);
+  font-variant-numeric: tabular-nums;
+  flex: 0 0 auto;
+}
+.per-log-payload {
+  margin-top: 2px;
+  font-size: calc(11.5px * var(--app-text-scale, 1));
+  color: var(--c-text-title);
+  word-break: break-word;
+}
+.per-log-outcome {
+  margin-top: 3px;
+  font-size: calc(10.5px * var(--app-text-scale, 1));
+  line-height: 1.5;
+  color: var(--c-text);
+}
+.per-log-skipped { color: var(--per-warn); }
+
+.per-empty {
+  padding: 32px 16px;
+  text-align: center;
+  font-size: calc(12.5px * var(--app-text-scale, 1));
+  color: var(--c-text);
+  line-height: 1.7;
+}
+
+/* 诊断：原始快照块 */
+.per-raw {
+  margin: 8px 16px 16px;
+  padding: 10px 12px;
+  border-radius: 10px;
+  background: var(--c-page-body-bg);
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: calc(10.5px * var(--app-text-scale, 1));
+  line-height: 1.55;
+  color: var(--c-text);
+  white-space: pre-wrap;
+  word-break: break-all;
+  max-height: 180px;
+  overflow: auto;
+}
+
+.per-actions {
+  display: flex;
+  gap: 10px;
+  padding: 4px 16px 8px;
+}
+.per-actions .ui-btn { flex: 1; }
diff --git a/styles/phone-widget.css b/styles/phone-widget.css
new file mode 100644
index 0000000..d947fba
--- /dev/null
+++ b/styles/phone-widget.css
@@ -0,0 +1,257 @@
+/* ═══ 桌面小组件设置页 ═══ */
+/*
+  结构：预览卡（最上，固定可见）→ 开关与角色 → 尺寸 → 模板 → 头像 → 主动生成。
+  预览放最上是因为它是这页的主角：用户改任何东西都该立刻看到结果。
+*/
+
+.widget-settings {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  font-size: 13px;
+}
+
+/* ── 诊断结果 ── */
+/*
+  逐行列出链路每一段的真实状态。桌面显示不对时，用户靠它转述给我们，
+  比反复描述「就是不行」有用得多。
+*/
+.ws-diagnosis {
+  margin-top: 10px;
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: var(--c-inset, #f2f2f6);
+  font-size: 11.5px;
+  line-height: 1.75;
+}
+.ws-diagnosis p {
+  margin: 0;
+  word-break: break-word;
+  color: var(--c-text-secondary, #8e8e98);
+}
+.ws-diagnosis p.is-ok { color: #2fa46a; }
+.ws-diagnosis p.is-bad { color: #d9534f; }
+.ws-diagnosis p.is-plain { opacity: 0.75; }
+
+/* ── 预览 ── */
+.ws-preview-card {
+  background: var(--c-card, #fff);
+  border-radius: 20px;
+  padding: 14px;
+  box-shadow: 0 2px 8px rgba(23, 23, 28, 0.05);
+}
+.ws-preview-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-bottom: 10px;
+}
+.ws-preview-head b { font-size: 14px; font-weight: 800; }
+.ws-preview-head span {
+  font-size: 11px;
+  color: var(--c-text-secondary, #8e8e98);
+  font-variant-numeric: tabular-nums;
+}
+
+/* 预览舞台：用棋盘格底衬出透明区域，看得出模板的圆角与透明度真实效果 */
+.ws-preview-stage {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 14px 8px;
+  border-radius: 14px;
+  background-color: #ececf0;
+  background-image:
+    linear-gradient(45deg, #e0e0e6 25%, transparent 25%),
+    linear-gradient(-45deg, #e0e0e6 25%, transparent 25%),
+    linear-gradient(45deg, transparent 75%, #e0e0e6 75%),
+    linear-gradient(-45deg, transparent 75%, #e0e0e6 75%);
+  background-size: 12px 12px;
+  background-position: 0 0, 0 6px, 6px -6px, -6px 0;
+  overflow-x: auto;
+}
+/* 预览框：尺寸就按用户配的 dp 来（CSS px 在手机上≈dp），所见即所得 */
+.ws-preview-frame {
+  border: 0;
+  display: block;
+  flex: 0 0 auto;
+  background: transparent;
+  max-width: 100%;
+}
+
+.ws-preview-actions {
+  display: flex;
+  gap: 8px;
+  margin-top: 12px;
+}
+.ws-preview-actions .ws-btn { flex: 1; }
+
+/* ── 通用卡片 ── */
+.ws-card {
+  background: var(--c-card, #fff);
+  border-radius: 20px;
+  padding: 14px;
+  box-shadow: 0 2px 8px rgba(23, 23, 28, 0.05);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.ws-card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+.ws-card-title { font-size: 13.5px; font-weight: 800; }
+
+/* ── 开关行 ── */
+.ws-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.ws-row-text { flex: 1; min-width: 0; }
+.ws-row-text b { font-size: 14px; font-weight: 700; display: block; }
+.ws-row-text p {
+  font-size: 11.5px;
+  color: var(--c-text-secondary, #8e8e98);
+  margin-top: 3px;
+  line-height: 1.5;
+}
+.ws-inline-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  font-size: 12px;
+  color: var(--c-text-secondary, #8e8e98);
+}
+
+/* ── 表单 ── */
+.ws-field {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  font-size: 12px;
+  font-weight: 700;
+  color: var(--c-text-secondary, #8e8e98);
+}
+.ws-field select,
+.ws-field input {
+  border: none;
+  border-radius: 12px;
+  padding: 10px 12px;
+  font-size: 13px;
+  background: var(--c-fill, #f0f0f4);
+  color: var(--c-text, #17171c);
+  outline: none;
+  max-width: 100%;
+  font-weight: 500;
+}
+.ws-grid2 {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+/* ── 模板编辑区 ── */
+.ws-template {
+  width: 100%;
+  border: none;
+  border-radius: 12px;
+  padding: 11px 12px;
+  background: var(--c-fill, #f0f0f4);
+  color: var(--c-text, #17171c);
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 11px;
+  line-height: 1.6;
+  resize: vertical;
+  outline: none;
+  box-sizing: border-box;
+}
+.ws-template-actions {
+  display: flex;
+  gap: 8px;
+}
+.ws-template-actions .ws-btn { flex: 1; }
+
+/* ── 按钮 ── */
+.ws-btn {
+  border: none;
+  border-radius: 999px;
+  padding: 11px 16px;
+  font-size: 13px;
+  font-weight: 700;
+  background: var(--c-text, #17171c);
+  color: #fff;
+  cursor: pointer;
+  transition: transform 0.16s ease;
+}
+.ws-btn:active { transform: scale(0.95); }
+.ws-btn:disabled { opacity: 0.45; cursor: default; }
+.ws-btn.ghost {
+  background: var(--c-card, #fff);
+  color: var(--c-text, #17171c);
+  border: 1px solid var(--c-line, #ebebf0);
+}
+.ws-link {
+  border: none;
+  background: none;
+  color: var(--c-accent, #7a5af8);
+  font-size: 12px;
+  font-weight: 700;
+  cursor: pointer;
+  padding: 2px 0;
+}
+
+/* ── 说明文字 ── */
+.ws-hint {
+  font-size: 11.5px;
+  color: var(--c-text-secondary, #8e8e98);
+  line-height: 1.65;
+}
+.ws-warn {
+  font-size: 11.5px;
+  line-height: 1.6;
+  color: #b8860b;
+  background: #fdf6e3;
+  border-radius: 10px;
+  padding: 9px 11px;
+}
+
+/* ── 占位符速查 ── */
+.ws-more summary {
+  font-size: 12.5px;
+  font-weight: 700;
+  color: var(--c-text-secondary, #8e8e98);
+  cursor: pointer;
+  padding: 2px 0;
+}
+/* details 上直接 flex 在 iOS Safari 不生效，间距交给内层 */
+.ws-placeholders {
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  padding-top: 8px;
+}
+.ws-placeholder-row {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  font-size: 11.5px;
+  line-height: 1.5;
+}
+.ws-placeholder-row code {
+  flex: 0 0 auto;
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10.5px;
+  background: var(--c-fill, #f0f0f4);
+  color: var(--c-accent, #7a5af8);
+  border-radius: 6px;
+  padding: 2px 6px;
+  font-weight: 700;
+}
+.ws-placeholder-row span {
+  flex: 1;
+  min-width: 0;
+  color: var(--c-text-secondary, #8e8e98);
+}
