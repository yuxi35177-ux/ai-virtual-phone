@@ -0,0 +1,126 @@
+"use client";
+
+// 截屏悬浮球 ↔ 安卓壳的桥。
+//
+// 与查岗的区别只有一个：**谁发起的**。
+//   查岗 = 角色到点想看你 → 有明确的 characterId；
+//   悬浮球 = 你自己点一下 → 没有 characterId，「发给谁」等同意后取最近会话。
+// 两者点击后都走 CheckInService 那套预览与审批，所以这里只做「拉起/收起」两件事。
+
+import type { ScreenshotBallCapabilities } from "./types";
+
+type BallBridgeLike = {
+  getScreenshotBallCapabilities?: () => string;
+  prepareScreenshotBall?: () => boolean;
+  stopScreenshotBall?: () => void;
+  setScreenshotBallStyle?: (json: string) => boolean;
+  getScreenshotBallStyle?: () => string;
+};
+
+function bridge(): BallBridgeLike | null {
+  if (typeof window === "undefined") return null;
+  const candidate = (window as unknown as { AndroidShell?: BallBridgeLike }).AndroidShell;
+  return candidate && typeof candidate === "object" ? candidate : null;
+}
+
+/** 壳是否提供悬浮球（老 APK 没有）。 */
+export function hasScreenshotBallBridge(): boolean {
+  return typeof bridge()?.prepareScreenshotBall === "function";
+}
+
+/** 读悬浮球能力与运行状态。 */
+export function readScreenshotBallCapabilities(): ScreenshotBallCapabilities {
+  try {
+    const raw = bridge()?.getScreenshotBallCapabilities?.();
+    if (!raw) return {};
+    const parsed = JSON.parse(raw) as ScreenshotBallCapabilities;
+    return parsed && typeof parsed === "object" ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+/**
+ * 拉起悬浮球。返回 false 多半是没给浮窗权限——调用方据此引导授权。
+ * 必须由网页在 App 前台时调用（Android 12+ 禁止后台启动前台服务）。
+ */
+export function prepareScreenshotBall(): boolean {
+  try {
+    return bridge()?.prepareScreenshotBall?.() === true;
+  } catch {
+    return false;
+  }
+}
+
+/** 收掉悬浮球。 */
+export function stopScreenshotBall(): void {
+  try {
+    bridge()?.stopScreenshotBall?.();
+  } catch {
+    /* 忽略 */
+  }
+}
+
+/** 壳是否支持自定义悬浮球外观（老 APK 没有）。 */
+export function supportsBallStyle(): boolean {
+  return typeof bridge()?.setScreenshotBallStyle === "function";
+}
+
+/** 悬浮球外观。 */
+export type BallStyle = {
+  /** 球上的文字，最多 4 字符；空串 = 不显示文字 */
+  text: string;
+  /** 主色，形如 #RRGGBB 或 #AARRGGBB */
+  color: string;
+  /** 直径（dp），32~96 */
+  diameter: number;
+  /**
+   * 自定义图片（base64 PNG，不含 data: 前缀）。
+   *
+   * 空串 = 清除图片、回到纯色圆点；undefined = 这次不改图片，
+   * 保留原样——两者必须区分开，否则「只改颜色」会把用户上传的图弄丢。
+   */
+  image?: string;
+};
+
+/**
+ * 把外观下发给原生并即时生效（球正显示着会当场重画）。
+ *
+ * @returns 原生是否收下；老壳返回 false（此时球仍是默认样子，不是错误）
+ */
+export function setScreenshotBallStyle(style: BallStyle): boolean {
+  try {
+    return bridge()?.setScreenshotBallStyle?.(JSON.stringify(style)) === true;
+  } catch {
+    return false;
+  }
+}
+
+/** 读原生当前的球外观（设置页回显用）。读不到返回 null。 */
+export function readScreenshotBallStyle(): BallStyle | null {
+  try {
+    const raw = bridge()?.getScreenshotBallStyle?.();
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as Partial<BallStyle>;
+    if (!parsed || typeof parsed !== "object") return null;
+    return {
+      text: typeof parsed.text === "string" ? parsed.text : "",
+      color: typeof parsed.color === "string" ? parsed.color : "",
+      diameter: Number.isFinite(Number(parsed.diameter)) ? Number(parsed.diameter) : 50,
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** 原生当前的球是否用了自定义图片。 */
+export function readBallHasImage(): boolean {
+  try {
+    const raw = bridge()?.getScreenshotBallStyle?.();
+    if (!raw) return false;
+    const parsed = JSON.parse(raw) as { hasImage?: boolean };
+    return parsed?.hasImage === true;
+  } catch {
+    return false;
+  }
+}
diff --git a/lib/screenshot/bridge.ts b/lib/screenshot/bridge.ts
new file mode 100644
index 0000000..25ccbaa
--- /dev/null
+++ b/lib/screenshot/bridge.ts
@@ -0,0 +1,140 @@
+"use client";
+
+// 截屏 ↔ 安卓壳的原生桥对接层。
+//
+// 与其它桥最大的不同：**它是异步的**。
+//   takeScreenshot() 本身是回调式 API，原生不可能同步把几 MB 的 PNG 返回；
+//   所以 captureScreenshot() 只负责「发起」，画面稍后经 window 的
+//   'shell-call-overlay' 事件（action='screenshot'）推回来。
+//   本模块把这条异步链路包装成一个 Promise，调用方不必自己处理事件与超时。
+//
+// 非壳环境或老 APK 一律安全降级，调用方无需分支判断。
+
+import { ensureShellOverlayListener, subscribeShellOverlayEvents } from "../shell-call-overlay";
+import type { ScreenshotCapabilities, ScreenshotCaptureResult, ScreenshotDiagnostics } from "./types";
+
+type ScreenshotBridgeLike = {
+  getScreenshotCapabilities?: () => string;
+  captureScreenshot?: () => string;
+  getScreenshotDiagnostics?: () => string;
+};
+
+function bridge(): ScreenshotBridgeLike | null {
+  if (typeof window === "undefined") return null;
+  const candidate = (window as unknown as { AndroidShell?: ScreenshotBridgeLike }).AndroidShell;
+  return candidate && typeof candidate === "object" ? candidate : null;
+}
+
+/** 壳是否提供截屏桥（老 APK 没有）。 */
+export function hasScreenshotBridge(): boolean {
+  return typeof bridge()?.captureScreenshot === "function";
+}
+
+/**
+ * 读截屏桥的内部状态（诊断面板用）。壳不支持或读失败都返回 null，
+ * 面板据此显示「当前版本不支持」，而不是抓一堆 undefined 去猜。
+ */
+export function readScreenshotDiagnostics(): ScreenshotDiagnostics | null {
+  try {
+    const raw = bridge()?.getScreenshotDiagnostics?.();
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as ScreenshotDiagnostics;
+    return parsed && typeof parsed === "object" ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * 读截屏能力与状态。壳不支持或读失败时全报 false——
+ * 与「有这能力但没授权」是两回事，所以三个字段分开报。
+ */
+export function readScreenshotCapabilities(): ScreenshotCapabilities {
+  try {
+    const raw = bridge()?.getScreenshotCapabilities?.();
+    if (!raw) return {};
+    const parsed = JSON.parse(raw) as ScreenshotCapabilities;
+    return parsed && typeof parsed === "object" ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+/** 发起时原生回的那一下：只表示「受理了没」。 */
+type CaptureAck = { ok: true } | { ok: false; reason: string };
+
+function parseAck(raw: unknown): CaptureAck {
+  if (typeof raw !== "string" || !raw) return { ok: false, reason: "截屏调用没有返回结果" };
+  try {
+    const parsed = JSON.parse(raw) as { ok?: boolean; reason?: string };
+    if (parsed?.ok === true) return { ok: true };
+    return { ok: false, reason: parsed?.reason || "截屏未能发起" };
+  } catch {
+    return { ok: false, reason: "截屏返回内容无法解析" };
+  }
+}
+
+/**
+ * 截一张当前屏幕。
+ *
+ * 返回 Promise：成功给 { ok:true, base64, width, height, bytes }，
+ * 失败给 { ok:false, reason }。**永远 resolve，不 reject**——
+ * 调用方拿到的要么是画面，要么是一句能转述给用户的原因。
+ *
+ * @param timeoutMs 等原生的上限。默认 8 秒：正常一两秒就回来；
+ *                  超时多半是无障碍中途被关或 ROM 卡住，此时必须给失败，
+ *                  否则 Promise 永远悬着、界面一直转圈。
+ */
+export function captureScreenshot(timeoutMs = 8000): Promise<ScreenshotCaptureResult> {
+  return new Promise<ScreenshotCaptureResult>((resolve) => {
+    const b = bridge();
+    if (!b?.captureScreenshot) {
+      resolve({ ok: false, reason: "当前 App 版本不支持截屏，需要更新安卓壳" });
+      return;
+    }
+
+    let settled = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let unsubscribe: (() => void) | undefined;
+
+    const finish = (result: ScreenshotCaptureResult) => {
+      if (settled) return;
+      settled = true;
+      if (timer) clearTimeout(timer);
+      unsubscribe?.();
+      resolve(result);
+    };
+
+    // 先订阅、再发起：原生回调可能很快，若反过来会漏掉事件。
+    ensureShellOverlayListener();
+    unsubscribe = subscribeShellOverlayEvents((event) => {
+      if (event.action !== "screenshot") return;
+      if (event.ok === false) {
+        finish({ ok: false, reason: event.reason || "截屏失败" });
+        return;
+      }
+      if (typeof event.base64 === "string" && event.base64) {
+        finish({
+          ok: true,
+          base64: event.base64,
+          width: typeof event.width === "number" ? event.width : 0,
+          height: typeof event.height === "number" ? event.height : 0,
+          bytes: typeof event.bytes === "number" ? event.bytes : 0,
+        });
+      }
+    });
+
+    timer = setTimeout(() => {
+      finish({ ok: false, reason: "截屏超时了，请确认无障碍服务还开着，然后重试" });
+    }, Math.max(1000, timeoutMs));
+
+    // 发起。这里同步抛或返回失败都在 finish 之前，settled 保证只结算一次。
+    let ack: CaptureAck;
+    try {
+      ack = parseAck(b.captureScreenshot());
+    } catch {
+      ack = { ok: false, reason: "截屏调用失败" };
+    }
+    if (!ack.ok) finish({ ok: false, reason: ack.reason });
+  });
+}
diff --git a/lib/screenshot/checkin-config.ts b/lib/screenshot/checkin-config.ts
new file mode 100644
index 0000000..b1b45c4
--- /dev/null
+++ b/lib/screenshot/checkin-config.ts
@@ -0,0 +1,267 @@
+"use client";
+
+// 查岗配置：**每个角色各自一套**（开关、间隔、每日上限）。
+//
+// 为什么按角色而不是全局：查岗是「角色想看看你在干嘛」，这件事的合适程度
+// 完全取决于你们的关系——黏人的那位可能想半小时看一次，正经的那位一天一次
+// 都嫌多。一个全局开关管不住这种差异，只能逼用户二选一（要么全开要么全关）。
+//
+// 默认值（用户拍板）：间隔 30~90 分钟、每天最多 3 次、**默认关闭**。
+// 关着的时候角色完全不知道有这个能力，也不会弹任何浮层。
+//
+// 存两份：配置（用户设的）+ 运行态（上次什么时候触发、今天触发了几次）。
+// 分开存是为了让「重置运行态」不必碰用户的设置。
+
+import { kvGet, kvSet, registerKvMigration } from "../kv-db";
+
+const CONFIG_KEY = "ai_phone_check_in_config_v1";
+const RUNTIME_KEY = "ai_phone_check_in_runtime_v1";
+registerKvMigration(CONFIG_KEY);
+registerKvMigration(RUNTIME_KEY);
+
+/** 单个角色的查岗设置。 */
+export type CheckInCharacterConfig = {
+  enabled: boolean;
+  /** 触发间隔下限（分钟） */
+  minMinutes: number;
+  /** 触发间隔上限（分钟）；等于 minMinutes 即固定间隔 */
+  maxMinutes: number;
+  /** 每天最多查岗几次 */
+  dailyLimit: number;
+};
+
+/** 运行态：决定「这次该不该触发」。 */
+export type CheckInRuntime = {
+  /** 上次触发时刻（毫秒）；0 = 从未触发 */
+  lastFiredAt: number;
+  /** 计数所属的日期（YYYY-MM-DD）；跨天就重置计数 */
+  dayKey: string;
+  /** 当天已触发次数 */
+  countToday: number;
+};
+
+export const CHECK_IN_DEFAULTS: CheckInCharacterConfig = {
+  enabled: false,
+  minMinutes: 30,
+  maxMinutes: 90,
+  dailyLimit: 3,
+};
+
+/** 间隔允许范围（分钟）：太短会变成监视，太长就失去「陪着你」的味道。 */
+export const CHECK_IN_MIN_INTERVAL = 5;
+export const CHECK_IN_MAX_INTERVAL = 720;
+/** 每日上限允许范围（次）。 */
+export const CHECK_IN_MAX_DAILY = 20;
+
+function clampNumber(value: unknown, min: number, max: number, fallback: number): number {
+  if (typeof value !== "number" || !Number.isFinite(value)) return fallback;
+  return Math.min(Math.max(Math.round(value), min), max);
+}
+
+function normalizeCharacter(raw: unknown): CheckInCharacterConfig {
+  if (!raw || typeof raw !== "object") return { ...CHECK_IN_DEFAULTS };
+  const source = raw as Partial<CheckInCharacterConfig>;
+  const minMinutes = clampNumber(
+    source.minMinutes,
+    CHECK_IN_MIN_INTERVAL,
+    CHECK_IN_MAX_INTERVAL,
+    CHECK_IN_DEFAULTS.minMinutes,
+  );
+  const maxMinutes = clampNumber(
+    source.maxMinutes,
+    minMinutes,
+    CHECK_IN_MAX_INTERVAL,
+    Math.max(minMinutes, CHECK_IN_DEFAULTS.maxMinutes),
+  );
+  return {
+    // 必须显式 true 才算开——查岗是「角色主动看你屏幕」，缺省绝不能是开
+    enabled: source.enabled === true,
+    minMinutes,
+    maxMinutes,
+    dailyLimit: clampNumber(
+      source.dailyLimit,
+      1,
+      CHECK_IN_MAX_DAILY,
+      CHECK_IN_DEFAULTS.dailyLimit,
+    ),
+  };
+}
+
+export type CheckInConfigMap = Record<string, CheckInCharacterConfig>;
+
+/** 读全部角色的查岗配置（含默认值补全）。 */
+export function loadCheckInConfig(): CheckInConfigMap {
+  try {
+    const raw = kvGet(CONFIG_KEY);
+    if (!raw) return {};
+    const parsed = JSON.parse(raw) as unknown;
+    if (!parsed || typeof parsed !== "object") return {};
+    const out: CheckInConfigMap = {};
+    for (const [characterId, value] of Object.entries(parsed as Record<string, unknown>)) {
+      out[characterId] = normalizeCharacter(value);
+    }
+    return out;
+  } catch {
+    return {};
+  }
+}
+
+/** 读某个角色的配置（没设过就是默认值，也就是关闭）。 */
+export function loadCharacterCheckIn(characterId: string): CheckInCharacterConfig {
+  return loadCheckInConfig()[characterId] ?? { ...CHECK_IN_DEFAULTS };
+}
+
+/** 写某个角色的配置。 */
+export function saveCharacterCheckIn(characterId: string, patch: Partial<CheckInCharacterConfig>): CheckInCharacterConfig {
+  const all = loadCheckInConfig();
+  const next = normalizeCharacter({ ...(all[characterId] ?? CHECK_IN_DEFAULTS), ...patch });
+  all[characterId] = next;
+  kvSet(CONFIG_KEY, JSON.stringify(all));
+  if (typeof window !== "undefined") {
+    window.dispatchEvent(new CustomEvent("check-in-config-changed"));
+  }
+  return next;
+}
+
+/** 有没有任何一个角色开着查岗（决定要不要预热原生服务）。 */
+export function hasAnyCheckInEnabled(): boolean {
+  return Object.values(loadCheckInConfig()).some(item => item.enabled);
+}
+
+/** 关掉所有角色的查岗（设置页的「全部关闭」）。 */
+export function disableAllCheckIn(): void {
+  const all = loadCheckInConfig();
+  for (const key of Object.keys(all)) {
+    all[key] = { ...all[key], enabled: false };
+  }
+  kvSet(CONFIG_KEY, JSON.stringify(all));
+  if (typeof window !== "undefined") {
+    window.dispatchEvent(new CustomEvent("check-in-config-changed"));
+  }
+}
+
+// ── 运行态 ──
+
+function todayKey(): string {
+  const d = new Date();
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+export function loadCheckInRuntime(): Record<string, CheckInRuntime> {
+  try {
+    const raw = kvGet(RUNTIME_KEY);
+    if (!raw) return {};
+    const parsed = JSON.parse(raw) as unknown;
+    return parsed && typeof parsed === "object" ? (parsed as Record<string, CheckInRuntime>) : {};
+  } catch {
+    return {};
+  }
+}
+
+function saveCheckInRuntime(runtime: Record<string, CheckInRuntime>): void {
+  kvSet(RUNTIME_KEY, JSON.stringify(runtime));
+}
+
+/** 取某个角色的运行态；跨天自动把当日计数归零（不写盘，读的时候就归零）。 */
+export function readCharacterRuntime(characterId: string): CheckInRuntime {
+  const entry = loadCheckInRuntime()[characterId];
+  const day = todayKey();
+  if (!entry || entry.dayKey !== day) {
+    return { lastFiredAt: entry?.lastFiredAt ?? 0, dayKey: day, countToday: 0 };
+  }
+  return entry;
+}
+
+/** 记一次触发（更新上次时间与当日计数）。 */
+export function markCheckInFired(characterId: string): void {
+  const runtime = loadCheckInRuntime();
+  const current = readCharacterRuntime(characterId);
+  runtime[characterId] = {
+    lastFiredAt: Date.now(),
+    dayKey: current.dayKey,
+    countToday: current.countToday + 1,
+  };
+  saveCheckInRuntime(runtime);
+}
+
+/** 清空某个角色的运行态（用户手动重置节奏用）。 */
+export function resetCheckInRuntime(characterId: string): void {
+  const runtime = loadCheckInRuntime();
+  delete runtime[characterId];
+  saveCheckInRuntime(runtime);
+}
+
+/**
+ * 一个角色的查岗调度快照，给设置页的「链路诊断」读。
+ *
+ * 为什么需要它：查岗不触发时，用户能看到的只有「没弹」这一个事实，
+ * 而真实原因可能是「没开」「今天次数用完了」「距上次还不够久」
+ * 「服务没起来」「权限没给」——五六种情况长得一模一样。
+ * 把配置与运行态一起摊开，用户一眼就能看出卡在哪一环。
+ */
+export type CheckInScheduleSnapshot = {
+  enabled: boolean;
+  minMinutes: number;
+  maxMinutes: number;
+  dailyLimit: number;
+  /** 上次触发时刻（毫秒）；0 = 从未触发 */
+  lastFiredAt: number;
+  /** 距上次触发过了多少分钟；从未触发时为 -1 */
+  minutesSinceLast: number;
+  /** 今天已触发次数（跨天已归零） */
+  countToday: number;
+  /** 今天是否已达上限 */
+  dailyReached: boolean;
+  /** 现在这一刻是否已到点（与引擎用的是同一个判定） */
+  due: boolean;
+};
+
+export function readCheckInScheduleSnapshot(
+  characterId: string,
+  config: CheckInCharacterConfig,
+): CheckInScheduleSnapshot {
+  const runtime = readCharacterRuntime(characterId);
+  const minutesSinceLast = runtime.lastFiredAt > 0
+    ? Math.floor((Date.now() - runtime.lastFiredAt) / 60_000)
+    : -1;
+  return {
+    enabled: config.enabled,
+    minMinutes: config.minMinutes,
+    maxMinutes: config.maxMinutes,
+    dailyLimit: config.dailyLimit,
+    lastFiredAt: runtime.lastFiredAt,
+    minutesSinceLast,
+    countToday: runtime.countToday,
+    dailyReached: runtime.countToday >= config.dailyLimit,
+    due: shouldFireCheckIn(characterId, config),
+  };
+}
+
+/** 在 [minMinutes, maxMinutes] 之间随机取一个等待分钟数。 */
+export function randomCheckInDelayMinutes(config: CheckInCharacterConfig): number {
+  const min = Math.max(CHECK_IN_MIN_INTERVAL, config.minMinutes);
+  const max = Math.max(min, config.maxMinutes);
+  if (max <= min) return min;
+  return min + Math.random() * (max - min);
+}
+
+/**
+ * 现在这个角色该不该触发查岗。
+ *
+ * 三个条件缺一不可：开着、今天没超上限、距上次触发够久了。
+ * 「够久」用随机间隔——固定节拍像定时器，真人是忽快忽慢的。
+ */
+export function shouldFireCheckIn(
+  characterId: string,
+  config: CheckInCharacterConfig,
+  now = Date.now(),
+): boolean {
+  if (!config.enabled) return false;
+  const runtime = readCharacterRuntime(characterId);
+  if (runtime.countToday >= config.dailyLimit) return false;
+  if (runtime.lastFiredAt <= 0) return true;
+  const elapsedMinutes = (now - runtime.lastFiredAt) / 60_000;
+  const threshold = randomCheckInDelayMinutes(config);
+  return elapsedMinutes >= threshold;
+}
diff --git a/lib/screenshot/checkin-engine.ts b/lib/screenshot/checkin-engine.ts
new file mode 100644
index 0000000..32000c6
--- /dev/null
+++ b/lib/screenshot/checkin-engine.ts
@@ -0,0 +1,404 @@
+import type { CheckInOutcome } from "./types";
+"use client";
+
+// 查岗引擎：决定「该不该查」→ 请原生弹浮层 → 按用户的选择推进。
+//
+// 三条路径：
+//   ① 用户同意 → 这张图以「你发的图片」进聊天，触发角色点评；
+//   ② 用户拒绝 → 只写一条系统事件（图根本没产生），让角色知道这次没给看；
+//   ③ 截屏失败/超时 → 同上，但原因不同，角色不会以为「你拒绝了」。
+//
+// 关键边界：
+//  - **没同意就没有图**：图片数据只在原生内存里；拒绝路径上网页侧从头到尾
+//    没拿到过 base64，所以这里不需要「清理」什么，也就不会漏删。
+//  - **不做隐蔽触发**：只有 shouldFireCheckIn 判定该触发时才调用，且
+//    每次都会弹浮层让用户当场决定——不存在「悄悄截了存起来」的路径。
+//  - **失败如实说**：没能截图时写的是「截屏失败」而不是「对方没给看」，
+//    免得角色误以为用户拒绝、做出委屈的反应。
+
+import { pushChatMessage, loadChatSessions } from "../chat-storage";
+import { loadCharacters } from "../character-storage";
+import { recordUserShot } from "./engine";
+import { requestBackgroundChatReply } from "../follow-up-service";
+import { storeMediaBase64 } from "../media-cache-storage";
+import {
+  loadCharacterCheckIn,
+  loadCheckInConfig,
+  markCheckInFired,
+  readCharacterRuntime,
+  shouldFireCheckIn,
+  type CheckInCharacterConfig,
+} from "./checkin-config";
+import { consumePendingUserShot, hasCheckInBridge, readCheckInCapabilities, requestCheckIn } from "./checkin";
+import { resolveCheckInGuidance } from "./checkin-guidance";
+import { ensureShellOverlayListener, subscribeShellOverlayEvents } from "../shell-call-overlay";
+
+/** 一次查岗尝试的结论（给调用方/设置页做记录用）。 */
+export type CheckInAttempt =
+  | { ok: true; accepted: true }
+  | { ok: true; accepted: false; reason: string }
+  | { ok: false; reason: string };
+
+/** 查岗是否具备条件（不开浮层也点不动）。 */
+export function checkInReadiness(): {
+  bridgeAvailable: boolean;
+  supported: boolean;
+  accessibilityOn: boolean;
+  overlayReady: boolean;
+  ready: boolean;
+} {
+  const caps = readCheckInCapabilities();
+  const bridgeAvailable = hasCheckInBridge();
+  const supported = caps.supported === true;
+  const accessibilityOn = caps.accessibilityOn === true;
+  const overlayReady = caps.canDraw === true;
+  return {
+    bridgeAvailable,
+    supported,
+    accessibilityOn,
+    overlayReady,
+    ready: bridgeAvailable && supported && accessibilityOn && overlayReady,
+  };
+}
+
+/** 找一个角色的最新私聊会话（查岗只发生在私聊里）。 */
+export function findLatestPrivateSession(characterId: string): string | null {
+  const sessions = loadChatSessions()
+    .filter(session => !session.isGroup && session.contactId === characterId)
+    .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
+  return sessions[0]?.id ?? null;
+}
+
+/**
+ * 对某个角色跑一次查岗（该不该触发要先由调用方判定）。
+ *
+ * @param config 该角色的查岗配置（调用方已读过，这里不再读一次，避免
+ *               判定与执行之间配置被改动造成不一致）
+ */
+export async function runCheckIn(
+  characterId: string,
+  config?: CheckInCharacterConfig,
+): Promise<CheckInAttempt> {
+  const cfg = config ?? loadCharacterCheckIn(characterId);
+  if (!cfg.enabled) return { ok: false, reason: "这个角色没有开启查岗" };
+
+  const sessionId = findLatestPrivateSession(characterId);
+  if (!sessionId) return { ok: false, reason: "还没有和这个角色的聊天" };
+
+  const readiness = checkInReadiness();
+  if (!readiness.bridgeAvailable) return { ok: false, reason: "当前 App 版本不支持查岗" };
+  if (!readiness.supported) return { ok: false, reason: "系统版本太低，查岗需要 Android 11 及以上" };
+  if (!readiness.accessibilityOn) return { ok: false, reason: "无障碍服务没有开启" };
+  if (!readiness.overlayReady) return { ok: false, reason: "浮窗权限没有授予，弹不出确认浮层" };
+
+  const character = loadCharacters().find(c => c.id === characterId);
+  const name = character?.name?.trim() || "TA";
+  const avatar = character?.avatar || "";
+
+  // 先记一次触发：无论用户最终给不给看，这次查岗都已经发生过，
+  // 都该计入当日上限——否则用户一直点「不给」就等于没有上限。
+  markCheckInFired(characterId);
+
+  const outcome = await requestCheckIn(characterId, name, avatar);
+
+  if (outcome.accepted) {
+    try {
+      // 用户在浮层里顺手说的话，先作为普通发言发出去——
+      // 这样角色看到的是「你说了一句话 + 一张图」，而不是一张没头没尾的截图。
+      if (outcome.reply) {
+        pushChatMessage({ sessionId, role: "user", content: outcome.reply });
+      }
+      // 关键：留一条系统事件说明「这张图是它自己查岗看到的」。
+      // 否则角色只见到一张以用户身份发出的图，会当成用户主动分享截图，
+      // 完全意识不到是自己在查岗——与拒绝路径那条说明正好不对称。
+      pushChatMessage({
+        sessionId,
+        role: "system",
+        content: `[${name}想看看你现在在做什么，你把屏幕给它看了]`,
+      });
+      const stored = await storeMediaBase64(outcome.base64, "image/png");
+      pushChatMessage({
+        sessionId,
+        role: "user",
+        content: "",
+        mediaType: "image",
+        mediaUrl: stored.ref,
+        mediaData: { label: "给你看我现在的屏幕" },
+      });
+      // 用户可给这次结果写一句反应指导语（设置 → 截屏 → 主动查岗）。
+      // 只随本轮请求送出、不落库——否则后面每一轮都会重新看到它。
+      const acceptedGuidance = resolveCheckInGuidance("accepted", name);
+      void requestBackgroundChatReply(
+        sessionId,
+        acceptedGuidance ? { ephemeralSystemNote: acceptedGuidance } : undefined,
+      ).catch(() => undefined);
+      return { ok: true, accepted: true };
+    } catch {
+      return { ok: false, reason: "图片没能保存，这次没发出去" };
+    }
+  }
+
+  // 拒绝时如果用户留了话，那句话是主动说的，照常作为发言送出。
+  // 顺序很关键：先发送言、再写「没给看」的事件，读起来才是因果正确的。
+  if (outcome.reply) {
+    pushChatMessage({ sessionId, role: "user", content: outcome.reply });
+  }
+
+  // 拒绝 / 超时 / 截屏失败：写一条只有角色看得见来源的系统事件，
+  // 让它能自然反应——但措辞要能区分「你不想给我看」和「没截成」。
+  const declined = outcome.reason === "user_rejected";
+  const timedOut = outcome.reason === "timeout";
+  const note = declined
+    ? `[${name}想看看你现在在做什么，你没有给它看${outcome.reply ? "，但回了一句话" : ""}]`
+    : timedOut
+      ? `[${name}想看看你现在在做什么，你没有回应]`
+      : `[${name}想看看你现在在做什么，但没能截到屏幕（${outcome.reason}）]`;
+  pushChatMessage({ sessionId, role: "system", content: note });
+  // 拒绝也让它有反应（用户明确要的）——被拒时该失落还是说没关系，交给角色自己决定。
+  // 三种失败结果各自可配指导语，同样只随本轮请求送出。
+  const guidanceKind = declined ? "declined" : timedOut ? "timeout" : "failed";
+  const guidance = resolveCheckInGuidance(guidanceKind, name);
+  void requestBackgroundChatReply(
+    sessionId,
+    guidance ? { ephemeralSystemNote: guidance } : undefined,
+  ).catch(() => undefined);
+  return { ok: true, accepted: false, reason: outcome.reason };
+}
+
+/**
+ * 处理一次「用户主动截屏」（悬浮球发起）。
+ *
+ * 与查岗的区别：没有指定角色——用户点球时只是想分享，发给谁是**现在**决定的。
+ * 取最近聊过的私聊会话作为目标：那是他此刻最可能想发的人。
+ *
+ * @param outcome 原生回传的结果（已确认用户点了「发给它」）
+ */
+export async function deliverUserShot(outcome: CheckInOutcome): Promise<{ ok: boolean; reason?: string }> {
+  if (!outcome.accepted) return { ok: false, reason: outcome.reason || "没有可发送的内容" };
+
+  // 目标优先用浮层里当场选定的那个（或设了默认角色时的默认值）。
+  // 老壳不带 characterId → 退回「最近聊过的私聊会话」，与加选择之前一致；
+  // 那也正是当时唯一可能发出去的人，不算猜错。
+  // 没有会话就没法发——如实失败，不硬造一个。
+  const sessionId = outcome.characterId
+    ? findLatestPrivateSession(outcome.characterId)
+    : loadChatSessions()
+        .filter(session => !session.isGroup)
+        .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))[0]?.id ?? null;
+  if (!sessionId) {
+    return {
+      ok: false,
+      reason: outcome.characterId
+        ? "和这个角色还没有聊天，不知道该往哪发"
+        : "还没有任何聊天，不知道发给谁",
+    };
+  }
+
+  try {
+    // 顺手说的话先发，图后发——读起来是「说了一句 + 配张图」。
+    if (outcome.reply) {
+      pushChatMessage({ sessionId, role: "user", content: outcome.reply });
+    }
+    // 存图 + 记进「最近截屏」列表：用户想回查刚才截了什么时，那张图必须
+    // 和查岗截的一视同仁地出现在列表里。两件事共用一次存储，拿回 ref 直接发消息。
+    //
+    // 这里曾经是 `void recordUserShot(...)` 顺手记一笔、再单独 storeMediaBase64——
+    // 而 recordUserShot 在 engine 里根本不存在，同步抛出的 TypeError 被外层
+    // catch 吞掉，于是「话发出去了、图和角色回应都没有」（用户实报）。
+    const record = await recordUserShot({
+      base64: outcome.base64,
+      width: outcome.width,
+      height: outcome.height,
+      bytes: outcome.bytes,
+    });
+    if (!record) {
+      return { ok: false, reason: "图片没能保存，这次没发出去" };
+    }
+    pushChatMessage({
+      sessionId,
+      role: "user",
+      content: "",
+      mediaType: "image",
+      mediaUrl: record.ref,
+      mediaData: { label: "给你看看我现在这边" },
+    });
+    void requestBackgroundChatReply(sessionId).catch(() => undefined);
+    return { ok: true };
+  } catch {
+    return { ok: false, reason: "图片没能保存，这次没发出去" };
+  }
+}
+
+/**
+ * 拉一次「用户主动截屏」的结果并送出去。
+ *
+ * 页面挂载时、以及收到 checkIn 事件时各调一次：
+ *   · 挂载时补发「点球那一刻页面已被系统回收」的那张；
+ *   · 事件时处理当场送达的。
+ * 原生侧是「读到即清空」，所以重复调用不会把同一张图发两遍。
+ *
+ * @returns 真正送出的一张图；没有待取或发送失败时返回 null。
+ */
+export async function flushPendingUserShot(): Promise<boolean> {
+  const pending = consumePendingUserShot();
+  if (!pending) return false;
+  const result = await deliverUserShot(pending);
+  return result.ok;
+}
+
+/**
+ * 启动「用户主动截屏」的接收端：页面挂载时补发一次，之后收到 checkIn 事件再拉一次。
+ *
+ * 必须挂在桌面壳这种「一直在跑」的地方，而不是设置页——用户点球时
+ * 多半正在别的 App 里，设置页根本没开。
+ *
+ * 重复调用无害：原生侧是「读到即清空」，拉两次不会把同一张图发两遍。
+ * 角色查岗也会触发同一个事件，但那条路上原生不写 pendingUserShot，
+ * 所以这里会拿到空、直接返回，不影响查岗自己的 Promise 流程。
+ */
+export function startUserShotBridge(): () => void {
+  if (typeof window === "undefined") return () => { /* noop */ };
+  if (!hasCheckInBridge()) return () => { /* noop */ };
+
+  // 挂载时补发：点球那一刻页面若已被系统回收，事件是丢的，只能靠这里捞回来
+  void flushPendingUserShot().catch(() => undefined);
+
+  ensureShellOverlayListener();
+  return subscribeShellOverlayEvents((event) => {
+    if (event.action !== "checkIn") return;
+    void flushPendingUserShot().catch(() => undefined);
+  });
+}
+
+/**
+ * 角色在聊天里主动请求看一眼屏幕（工具箱 → 内置能力「想看看你的屏幕」）。
+ *
+ * 与定时查岗（runCheckIn）共用同一套审批与额度，但落地方式必须不同：
+ *   · 定时查岗发生在**没有对话**的时候，看完得自己另起一轮回复
+ *     （所以那边要调 requestBackgroundChatReply）；
+ *   · 这个发生在**对话进行中**，结果直接交回给模型、在同一轮里点评——
+ *     这里若也去起背景回复，就会变成「回两条」。
+ *
+ * 相同的是：一样弹浮层、一样要用户点「给它看」，拒绝路径一样不产生图片、
+ * 一样记一次额度（否则角色一直点「不给」就等于没有上限）。
+ */
+export type CheckInToolOutcome = {
+  /** 动作本身是否正常走完（含「用户没给看」这种正常结果） */
+  ok: boolean;
+  /** 用户是否真的给了图 */
+  accepted?: boolean;
+  /** 给模型看的说明：ok=true 时是所见/被拒的交代，ok=false 时是失败原因 */
+  message: string;
+};
+
+export async function requestCheckInForTool(characterId: string): Promise<CheckInToolOutcome> {
+  const cfg = loadCharacterCheckIn(characterId);
+  if (!cfg.enabled) {
+    return {
+      ok: false,
+      message: "TA 还没有为你开启查岗（设置 → 截屏 → 主动查岗），所以现在不能要求看屏幕。",
+    };
+  }
+
+  const runtime = readCharacterRuntime(characterId);
+  if (runtime.countToday >= cfg.dailyLimit) {
+    return {
+      ok: false,
+      message: `今天已经看过 ${runtime.countToday} 次了（上限 ${cfg.dailyLimit} 次），今天别再要求了。`,
+    };
+  }
+
+  const readiness = checkInReadiness();
+  if (!readiness.bridgeAvailable) return { ok: false, message: "当前 App 版本不支持这个动作，需要更新安卓壳。" };
+  if (!readiness.supported) return { ok: false, message: "TA 的系统版本太低（需要 Android 11 及以上），暂时做不到。" };
+  if (!readiness.accessibilityOn) return { ok: false, message: "TA 还没有开启无障碍服务，暂时截不到屏幕。" };
+  if (!readiness.overlayReady) return { ok: false, message: "TA 还没有授予浮窗权限，弹不出确认框。" };
+
+  const sessionId = findLatestPrivateSession(characterId);
+  const character = loadCharacters().find(c => c.id === characterId);
+  const name = character?.name?.trim() || "TA";
+  const avatar = character?.avatar || "";
+
+  // 先记一次：请求已经发出去了，无论用户最终给不给看。
+  markCheckInFired(characterId);
+
+  const outcome = await requestCheckIn(characterId, name, avatar);
+
+  if (outcome.accepted) {
+    try {
+      if (outcome.reply && sessionId) {
+        pushChatMessage({ sessionId, role: "user", content: outcome.reply });
+      }
+      if (sessionId) {
+        // 这条系统事件是给角色看的：否则它只见到一张「用户发的图」，
+        // 会当成对方主动分享，误以为和自己这个请求无关。
+        pushChatMessage({
+          sessionId,
+          role: "system",
+          content: `[${name}想看看你现在在做什么，你把屏幕给它看了]`,
+        });
+        const stored = await storeMediaBase64(outcome.base64, "image/png");
+        pushChatMessage({
+          sessionId,
+          role: "user",
+          content: "",
+          mediaType: "image",
+          mediaUrl: stored.ref,
+          mediaData: { label: "给你看我现在的屏幕" },
+        });
+      }
+      return {
+        ok: true,
+        accepted: true,
+        message: "TA 把屏幕给你看了，画面已经作为一条消息出现在聊天里。"
+          + "结合你看到的内容自然地回应一句就好，不要逐项列举你看到了什么——那很像在汇报监控。",
+      };
+    } catch {
+      return { ok: false, message: "图拿到手了但没能存下来，这次没看成。" };
+    }
+  }
+
+  // 拒绝时如果用户留了话，那句话是主动说的，照常作为发言送出。
+  if (outcome.reply && sessionId) {
+    pushChatMessage({ sessionId, role: "user", content: outcome.reply });
+  }
+
+  const declined = outcome.reason === "user_rejected";
+  const timedOut = outcome.reason === "timeout";
+  if (sessionId) {
+    const note = declined
+      ? `[${name}想看看你现在在做什么，你没有给它看${outcome.reply ? "，但回了一句话" : ""}]`
+      : timedOut
+        ? `[${name}想看看你现在在做什么，你没有回应]`
+        : `[${name}想看看你在做什么，但没能截到屏幕（${outcome.reason}）]`;
+    pushChatMessage({ sessionId, role: "system", content: note });
+  }
+
+  return {
+    ok: true,
+    accepted: false,
+    message: declined
+      ? "TA 这次没有给你看。不要追问、不要闹脾气、不要反复请求，自然地把话题接下去就好。"
+      : timedOut
+        ? "TA 没有回应你的请求（可能不在手机前）。不要在同一个点上再试一次。"
+        : `这次没能截到屏幕（${outcome.reason}）。不要再重复尝试。`,
+  };
+}
+
+/**
+ * 扫一遍所有角色，把到点的查岗跑一遍。
+ *
+ * 挂进桌面壳的轮询（与定时主动联系同一处）。刻意串行执行：
+ * 同一时刻只弹一个浮层——两个浮层叠在一起，用户根本没法处理。
+ */
+export async function pollDueCheckIns(): Promise<number> {
+  const all = loadCheckInConfig();
+  let fired = 0;
+  for (const [characterId, config] of Object.entries(all)) {
+    if (!shouldFireCheckIn(characterId, config)) continue;
+    const result = await runCheckIn(characterId, config);
+    if (result.ok) fired += 1;
+  }
+  return fired;
+}
+
