+  cacheAgeMs?: number;
+  /** 最近一次失败原因（空串 = 没记到失败） */
+  lastError?: string;
+};
+
+/** 位置桥上报的内部状态（诊断用，不含具体坐标）。 */
+export type LocationDiagnostics = {
+  /** 是否正有一次取点在进行 */
+  fixing?: boolean;
+  /** 累计成功取点次数 */
+  fixCount?: number;
+  /** 原生手里有没有缓存值 */
+  hasCache?: boolean;
+  /** 缓存年龄（毫秒），-1 = 没有缓存 */
+  cacheAgeMs?: number;
+  /** 最近一次失败原因（空串 = 没记到失败） */
+  lastError?: string;
+};
