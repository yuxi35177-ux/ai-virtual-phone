+"use client";
+
+// 查岗 / 截屏确认浮层的配色设置。
+//
+// 与「通话浮窗外观」同一套交互（见 components/settings/call-overlay-settings.tsx）：
+//   · 选预设 —— 一键换整套配色（6 套）；
+//   · 逐项自定义 —— 想单独调某一级颜色时用它，改动叠在预设之上，
+//     没动到的项仍跟随预设。
