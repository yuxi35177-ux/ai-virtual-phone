index 0000000..5d15603
--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/HealthBridge.kt
@@ -0,0 +1,282 @@
+package app.floatphone.shell
+
+import android.content.Context
+import android.content.Intent
+import androidx.health.connect.client.HealthConnectClient
+import androidx.health.connect.client.permission.HealthPermission
+import androidx.health.connect.client.records.SleepSessionRecord
+import androidx.health.connect.client.request.ReadRecordsRequest
+import androidx.health.connect.client.time.TimeRangeFilter
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import org.json.JSONObject
+import java.time.Instant
+import java.time.temporal.ChronoUnit
+
+/**
+ * 健康桥：把「昨晚睡了多久」交给网页。
+ *
+ * 为什么走 Health Connect 而不是直接读某个运动 App：
+ *   华为运动健康、小米运动、三星健康各有一套私有数据，接一家就只能覆盖一部分
+ *   用户；Health Connect 由系统统一汇聚，这些 App 的数据都会写进去，接一次就
+ *   对所有 ROM 生效。代价是用户得在系统里启用它并逐项授权——这个代价是明摆着的，
+ *   所以界面上会如实说明，而不是假装零成本。
+ *
+ * 设计边界（改这个文件前先读）：
+ *  - **只读不写**：只申请 READ_SLEEP，不申请任何写入权限。角色不该往用户的
+ *    健康档案里写东西，那是医疗数据，不是聊天记录。
+ *  - **只读睡眠**：不读心率、血氧、体重这些更身体性的指标。睡眠时长已经足够
+ *    支撑「你昨晚没睡好」这种关心；往下读是另一个量级的隐私，得有明确需求再加。
+ *  - **只回时长与起止**：不回睡眠分期（深睡/浅睡/REM）。分期是医学化的读数，
+ *    角色拿它说事只会像个体检报告。
+ *  - **取不到就如实说取不到**：没装 / 没授权 / 没数据，都返回空，绝不编一个
+ *    「昨晚睡了 8 小时」——这种假数据角色会当真，比不说糟得多。
+ */
+class HealthBridge(private val context: Context) {
+
+    companion object {
+        /**
+         * 读取睡眠所需的 Health Connect 权限。
+         *
+         * 用 getReadPermission(SleepSessionRecord::class) 而不是某个
+         * PERMISSION_* 常量：Health Connect 里没有「睡眠」专用常量，
+         * 权限是按记录类型算出来的。
+         *
+         * 用 get() 属性而不是 val 初始化：它是函数调用，写在初始化表达式里
+         * 会在类加载时就执行，万一抛异常等于整个桥都不可用；按需算最多只坏一次。
+         */
+        val PERM_SLEEP: String
+            get() = HealthPermission.getReadPermission(SleepSessionRecord::class)
+
+        /** 缓存存活多久。睡眠数据一天才变几次，没必要频繁重读。 */
+        private const val CACHE_TTL_MS = 30 * 60 * 1000L
+
+        /** 往回看多少小时。36 小时足够覆盖「昨晚那一觉」而不拖进前天的。 */
+        private const val LOOKBACK_HOURS = 36L
+
+        /**
+         * 缓存。Health Connect 的读取是挂起函数，而网页要能同步读，
+         * 所以必须由后台协程取好、这里存着。
+         */
+        @Volatile
+        private var cachedJson: String = ""
+
+        @Volatile
+        private var cachedAt: Long = 0L
+
+        /** 睡眠读取权限当前是否已授予（异步刷新，网页靠轮询确认）。 */
+        @Volatile
+        private var granted = false
+
+        /** 是否正有一次刷新在进行（避免叠请求）。 */
+        @Volatile
+        private var refreshing = false
+
+        /** 最近一次失败原因（诊断用）。 */
+        @Volatile
+        private var lastError: String = ""
+
+        /** 累计成功刷新次数（诊断用）。 */
+        @Volatile
+        private var refreshCount = 0
+    }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    // ── 可用性 ──────────────────────────────────────
+
+    /**
+     * Health Connect 在这台设备上能不能用。
+     *
+     * 三种结果要分开：
+     *   SDK_AVAILABLE                    —— 能用；
+     *   SDK_UNAVAILABLE_PROVIDER_UPDATE_REQUIRED —— 装了但版本太旧，得去更新；
+     *   SDK_UNAVAILABLE                  —— 没装（Android 13 及以下），得先去装。
+     * 合成的「不能用」没法告诉用户下一步该干嘛，所以原样往上报。
+     */
+    fun sdkStatus(): Int = try {
+        HealthConnectClient.getSdkStatus(context)
+    } catch (e: Throwable) {
+        HealthConnectClient.SDK_UNAVAILABLE
+    }
+
+    /** 能不能读（只有 SDK_AVAILABLE 才算能）。 */
+    fun isAvailable(): Boolean = sdkStatus() == HealthConnectClient.SDK_AVAILABLE
+
+    /** 睡眠读取权限是否已授予（读的是异步刷新的缓存）。 */
+    fun hasSleepPermission(): Boolean = granted
+
+    /**
+     * 跳到 Health Connect 的设置页（用户在那里看数据来源与撤销授权）。
+     * 未安装时退回应用市场页，让用户能装上。返回是否成功跳转。
+     */
+    fun openHealthSettings(): Boolean = try {
+        context.startActivity(
+            Intent(HealthConnectClient.ACTION_HEALTH_CONNECT_SETTINGS)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+        )
+        true
+    } catch (e: Throwable) {
+        // 没装 Health Connect 时上面的 Activity 不存在，跳不动——
+        // 退回应用市场页让用户能装上，而不是静默什么都不发生。
+        try {
+            context.startActivity(
+                Intent(
+                    Intent.ACTION_VIEW,
+                    android.net.Uri.parse("market://details?id=com.google.android.apps.healthdata"),
+                ).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+            )
+            true
+        } catch (e2: Throwable) {
+            false
+        }
+    }
+
+    // ── 刷新（异步取，落缓存）──────────────────────
+
+    /**
+     * 取一次权限状态与最近的睡眠数据，落进缓存。
+     *
+     * 为什么是「取好存着」而不是「读的时候现取」：Health Connect 的每个
+     * API 都是挂起函数，而 @JavascriptInterface 必须是同步的。所以模式与
+     * 位置桥一致：网页按采样周期先调 refresh，下一次读走缓存。
+     */
+    fun refresh() {
+        if (refreshing) return
+        if (!isAvailable()) {
+            // 记下「不可用」而不是留个空缓存：诊断面板要能区分
+            // 「没装 Health Connect」和「装了但没给权限」。
+            lastError = "Health Connect 不可用（未安装或需更新）"
+            return
+        }
+        refreshing = true
+        scope.launch {
+            try {
+                // 权限控制器要从客户端上拿（client.permissionController）。
+                // 原来写的 PermissionController.create(context) 并不存在——
+                // 那是凭印象写的，CI 已证伪。
+                val client = HealthConnectClient.getOrCreate(context)
+                val has = client.permissionController.getGrantedPermissions().contains(PERM_SLEEP)
+                granted = has
+                if (!has) {
+                    cachedJson = ""
+                    cachedAt = 0L
+                    lastError = "还没有睡眠读取权限"
+                    return@launch
+                }
+                // 缓存还新鲜就不重读。网页每个采样周期都会调一次 refresh，
+                // 而睡眠一天才变几次——不拦一下等于每分钟往 Health Connect
+                // 查一次，纯属白耗电。
+                if (cachedJson.isNotEmpty()
+                    && System.currentTimeMillis() - cachedAt < CACHE_TTL_MS
+                ) {
+                    lastError = ""
+                    return@launch
+                }
+                readSleepIntoCache()
+                lastError = ""
+                refreshCount += 1
+            } catch (e: Throwable) {
+                lastError = e.message ?: "读健康数据失败"
+            } finally {
+                refreshing = false
+            }
+        }
+    }
+
+    /**
+     * 读最近 36 小时的睡眠，合并成「最近一觉」写进缓存。
+     *
+     * 合并口径：按时间排序后，把**结束时刻的间隔小于 2 小时**的相邻段算作
+     * 同一觉——手环常把一夜拆成好几段（中途醒了），不合并就会报成
+     * 「睡了 3 觉，每觉两小时」，读着像故障。间隔大于 2 小时则视为两觉
+     * （午睡、夜班分段），分开算，只报最近那一觉。
+     */
+    private suspend fun readSleepIntoCache() {
+        val client = HealthConnectClient.getOrCreate(context)
+        val end = Instant.now()
+        val start = end.minus(LOOKBACK_HOURS, ChronoUnit.HOURS)
+        val response = client.readRecords(
+            ReadRecordsRequest(
+                recordType = SleepSessionRecord::class,
+                timeRangeFilter = TimeRangeFilter.between(start, end),
+            ),
+        )
+
+        val sessions = response.records
+            .filter { it.endTime.isAfter(it.startTime) }
+            .sortedBy { it.startTime }
+        if (sessions.isEmpty()) {
+            cachedJson = ""
+            cachedAt = System.currentTimeMillis()
+            return
+        }
+
+        // 合并相邻段：间隔 < 2 小时视为同一觉
+        data class Span(var start: Instant, var end: Instant)
+        val merged = ArrayList<Span>()
+        for (record in sessions) {
+            val last = merged.lastOrNull()
+            if (last != null && ChronoUnit.MINUTES.between(last.end, record.startTime) < 120) {
+                if (record.endTime.isAfter(last.end)) last.end = record.endTime
+            } else {
+                merged.add(Span(record.startTime, record.endTime))
+            }
+        }
+        val latest = merged.last()
+        val minutes = ChronoUnit.MINUTES.between(latest.start, latest.end).toInt()
+
+        val json = JSONObject()
+            .put("sleepMinutes", minutes.coerceAtLeast(0))
+            .put("sleepEndAt", latest.end.toEpochMilli())
+            .put("sleepStartAt", latest.start.toEpochMilli())
+        cachedJson = json.toString()
+        cachedAt = System.currentTimeMillis()
+    }
+
+    // ── 同步读取（网页用）──────────────────────────
+
+    /**
+     * 读缓存的最近一觉。返回 JSON：{sleepMinutes, sleepEndAt, sleepStartAt}；
+     * 没有新鲜缓存时返回空对象。
+     *
+     * 刻意不在这里「顺手取一次」：读取是挂起函数，同步方法里取不了；
+     * 硬要取只能阻塞等，会把 WebView 主线程卡住。
+     */
+    fun readJson(): JSONObject {
+        if (!granted) return JSONObject()
+        if (cachedJson.isEmpty()) return JSONObject()
+        if (System.currentTimeMillis() - cachedAt > CACHE_TTL_MS) return JSONObject()
+        return runCatching { JSONObject(cachedJson) }.getOrDefault(JSONObject())
+    }
+
+    /**
+     * 能力与授权状态。
+     *
+     * 三项分开报，用户才知道卡在哪一环：
+     *   health          —— 这个壳版本接没接（接了）；
+     *   healthAvailable —— Health Connect 装没装 / 能不能用；
+     *   healthGranted   —— 睡眠读取权限给没给。
+     * 「能用但没授权」和「根本不可用」是两回事，混在一起用户不知道下一步干嘛。
+     */
+    fun capabilitiesJson(): String = JSONObject()
+        .put("health", true)
+        .put("healthAvailable", isAvailable())
+        .put("healthGranted", granted)
+        .put("healthSdkStatus", sdkStatus())
+        .toString()
+
+    /** 诊断面板用的内部状态（只含状态与计数，不含睡眠内容）。 */
+    fun diagnosticsJson(): String = JSONObject()
+        .put("available", isAvailable())
+        .put("granted", granted)
+        .put("refreshing", refreshing)
+        .put("refreshCount", refreshCount)
+        .put("hasCache", cachedJson.isNotEmpty()
+            && System.currentTimeMillis() - cachedAt <= CACHE_TTL_MS)
+        .put("cacheAgeMs", if (cachedAt > 0) System.currentTimeMillis() - cachedAt else -1)
+        .put("lastError", lastError)
+        .toString()
+}
diff --git a/android-shell/app/src/main/java/app/floatphone/shell/LocalApiBridge.kt b/android-shell/app/src/main/java/app/floatphone/shell/LocalApiBridge.kt
new file mode 100644
index 0000000..3d8cc56
--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/LocalApiBridge.kt
@@ -0,0 +1,138 @@
+package app.floatphone.shell
+
+import android.net.Uri
+import android.util.Base64
+import android.webkit.WebView
+import androidx.webkit.JavaScriptReplyProxy
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.Semaphore
+import java.util.concurrent.TimeUnit
+
+/** Origin-scoped, main-frame-only transport for phone-local AI endpoints. No cloud proxy. */
+class LocalApiBridge(private val webView: WebView, siteUrl: String) {
+    private val origin = Uri.parse(siteUrl).buildUpon().path(null).query(null).fragment(null).build().toString().trimEnd('/')
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(10, TimeUnit.SECONDS)
+        .readTimeout(90, TimeUnit.SECONDS)
+        .callTimeout(10, TimeUnit.MINUTES)
+        // A local service must never redirect a key or prompt to another host.
+        .followRedirects(false).followSslRedirects(false)
+        .proxy(java.net.Proxy.NO_PROXY)
+        .build()
+    private class Transfer(val call: Call, val reply: JavaScriptReplyProxy) {
+        val demand = Semaphore(0)
+        var pulling = false
+    }
+    // Accessed on the UI thread, except demand/call which are thread-safe.
+    private val transfers = mutableMapOf<String, Transfer>()
+
+    fun attach() {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return
+        WebViewCompat.addWebMessageListener(webView, "FloatLocalApi", setOf(origin)) { _, message, source, isMainFrame, reply ->
+            if (!isMainFrame || source.toString().trimEnd('/') != origin) return@addWebMessageListener
+            val json = runCatching { JSONObject(message.data ?: "") }.getOrNull() ?: return@addWebMessageListener
+            val id = json.optString("id")
+            if (!id.matches(Regex("[a-zA-Z0-9-]{1,80}"))) return@addWebMessageListener
+            when (json.optString("type")) {
+                "cancel" -> transfers.remove(id)?.let { it.call.cancel(); it.demand.release() }
+                "pull" -> transfers[id]?.let {
+                    if (!it.pulling) { it.pulling = true; it.demand.release() }
+                }
+                "start" -> start(id, json, reply)
+            }
+        }
+    }
+
+    private fun post(reply: JavaScriptReplyProxy, json: JSONObject) {
+        runCatching { reply.postMessage(json.toString()) }
+    }
+
+    private fun start(id: String, json: JSONObject, reply: JavaScriptReplyProxy) {
+        if (transfers.containsKey(id)) return
+        val request = runCatching {
+            require(transfers.size < 8)
+            val uri = Uri.parse(json.getString("url"))
+            require(uri.scheme == "http" || uri.scheme == "https")
+            require(uri.userInfo == null && uri.fragment == null)
+            // No DNS for localhost: map it to a numeric loopback address.
+            require(uri.host?.lowercase() in setOf("localhost", "127.0.0.1", "::1", "[::1]"))
+            require(uri.port == -1 || uri.port in 1..65535)
+            val path = uri.path ?: ""
+            require(Regex("/(models|chat/completions|embeddings|messages)$").containsMatchIn(path) ||
+                Regex("/models/[^/]+:(streamGenerateContent|generateContent)$").containsMatchIn(path))
+            val target = if (uri.host == "localhost") uri.buildUpon().encodedAuthority(
+                "127.0.0.1" + if (uri.port > 0) ":${uri.port}" else ""
+            ).build().toString() else uri.toString()
+            val method = json.optString("method", "GET").uppercase()
+            require(method == "GET" || method == "POST")
+            val body = if (json.isNull("body")) "" else json.getString("body")
+            require(body.toByteArray(Charsets.UTF_8).size <= 16 * 1024 * 1024)
+            val builder = Request.Builder().url(target)
+            val headers = json.optJSONObject("headers") ?: JSONObject()
+            headers.keys().forEach { name ->
+                if (name.lowercase() in setOf("authorization", "content-type", "x-api-key", "anthropic-version", "accept")) {
+                    builder.header(name, headers.getString(name))
+                }
+            }
+            builder.method(method, if (method == "POST") body.toRequestBody("application/json".toMediaType()) else null).build()
+        }.getOrNull()
+        if (request == null) {
+            post(reply, JSONObject().put("id", id).put("type", "error"))
+            return
+        }
+        val call = client.newCall(request)
+        val transfer = Transfer(call, reply)
+        transfers[id] = transfer
+        fun deliver(type: String, fill: (JSONObject) -> Unit = {}) {
+            val event = JSONObject().put("id", id).put("type", type).also(fill)
+            webView.post {
+                if (transfers[id] !== transfer) return@post
+                if (type == "chunk") transfer.pulling = false
+                post(reply, event)
+                if (type == "error" || type == "end") transfers.remove(id)
+            }
+        }
+        call.enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) { deliver("error") }
+            override fun onResponse(call: Call, response: Response) {
+                response.use {
+                    try {
+                        deliver("headers") {
+                            it.put("status", response.code)
+                                .put("contentType", response.header("Content-Type") ?: "application/json")
+                        }
+                        val input = response.body?.byteStream()
+                        if (input == null) { deliver("end"); return }
+                        val buffer = ByteArray(16 * 1024)
+                        while (!call.isCanceled()) {
+                            // Backpressure: only read when JavaScript has capacity.
+                            if (!transfer.demand.tryAcquire(90, TimeUnit.SECONDS)) {
+                                call.cancel(); deliver("error"); return
+                            }
+                            if (call.isCanceled()) return
+                            val count = input.read(buffer)
+                            if (count < 0) { deliver("end"); return }
+                            val data = Base64.encodeToString(buffer, 0, count, Base64.NO_WRAP)
+                            deliver("chunk") { it.put("data", data) }
+                        }
+                    } catch (_: Exception) { deliver("error") }
+                }
+            }
+        })
+    }
+
+    fun cancelAll() {
+        transfers.values.forEach { it.call.cancel(); it.demand.release() }
+        transfers.clear()
+    }
+}
diff --git a/android-shell/app/src/main/java/app/floatphone/shell/LocationBridge.kt b/android-shell/app/src/main/java/app/floatphone/shell/LocationBridge.kt
new file mode 100644
index 0000000..e2ca8d7
--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/LocationBridge.kt
@@ -0,0 +1,339 @@
+package app.floatphone.shell
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.location.Geocoder
+import android.location.Location
+import android.location.LocationListener
+import android.location.LocationManager
+import android.os.Build
+import android.os.Bundle
+import android.os.CancellationSignal
+import android.os.Handler
+import android.os.Looper
+import androidx.core.content.ContextCompat
+import org.json.JSONObject
+import java.util.Locale
+import kotlin.math.abs
+import kotlin.math.round
+
+/**
+ * 位置桥：把「手机现在大概在哪儿」交给网页。
+ *
+ * 与 PerceptionBridge 同一分工：本类只「读」与「取名」，不做判断——
+ * 什么时候算「到了一个新地方」、要不要告诉角色，全部由网页侧的
+ * lib/perception 决定，阈值随网页部署即时生效。
+ *
+ * 设计边界（改这个文件前先读）：
+ *  - **只前台、不后台**：只用前台运行时权限，刻意**不申请**
+ *    ACCESS_BACKGROUND_LOCATION。采样本来就发生在 App 活着的时候
+ *    （网页定时器），后台持续定位只会白耗电，并把「角色知道我大概在哪」
+ *    升级成「角色一直跟着我」——那是另一件事，不该顺手做掉。
+ *  - **不追踪轨迹**：只回一个「当前位置」，不保留历史、不记录路径、
+ *    不识别常去地点。网页只在两次取值之间比一下距离。
+ *  - **坐标降精度**：上报前四舍五入到小数点后 3 位（约 110 米）。
+ *    「到家了」「到公司了」只需要这个量级，精确坐标却能定位到具体楼栋。
+ *  - **地名只到区/街道级**：刻意不取门牌与地标名。
+ *  - 未授权、定位开关关着、取不到，都如实返回空对象。调用方据此说
+ *    「读不到」，绝不返回一个假坐标——角色会当真，比不说更糟。
+ */
+class LocationBridge(private val context: Context) {
+
+    companion object {
+        /** 缓存的定位结果存活多久。超过就视为过时，宁可不报。 */
+        private const val CACHE_TTL_MS = 10 * 60 * 1000L
+
+        /** 一次性取点的超时。定位冷启动要几秒，但别让网页干等。 */
+        private const val FIX_TIMEOUT_MS = 12_000L
+
+        /** 坐标保留几位小数。3 位约 110 米，够说「到了哪一片」。 */
+        private const val COORD_DECIMALS = 3
+
+        /**
+         * 缓存最近一次结果。
+         *
+         * 定位是异步的，而这个桥要被网页同步读取，所以必须有缓存这一层。
+         * 进程被杀会丢，无所谓——下次采样会重新取。
+         */
+        @Volatile
+        private var cachedJson: String = ""
+
+        @Volatile
+        private var cachedAt: Long = 0L
+
+        /** 是否正有一次取点在进行（避免反复刷新叠出一堆请求）。 */
+        @Volatile
+        private var fixing = false
+
+        /** 诊断留痕：最近一次失败原因与累计取点次数。 */
+        @Volatile
+        private var lastError: String = ""
+
+        @Volatile
+        private var fixCount: Int = 0
+    }
+
+    private val main = Handler(Looper.getMainLooper())
+
+    // ── 权限与开关状态 ──────────────────────────
+
+    private fun granted(permission: String): Boolean = try {
+        ContextCompat.checkSelfPermission(context, permission) == PackageManager.PERMISSION_GRANTED
+    } catch (e: Throwable) {
+        false
+    }
+
+    /** 是否拿到精确定位。 */
+    fun hasFine(): Boolean = granted(Manifest.permission.ACCESS_FINE_LOCATION)
+
+    /** 是否拿到粗略定位。 */
+    fun hasCoarse(): Boolean = granted(Manifest.permission.ACCESS_COARSE_LOCATION)
+
+    /** 粗略或精确，任一到手就能读（系统按精度档授权）。 */
+    fun hasAny(): Boolean = hasFine() || hasCoarse()
+
+    /**
+     * 系统定位总开关开着没。
+     *
+     * 必须单独报：权限给了但用户在快捷开关里关了定位，读出来永远是空的。
+     * 不区分这两件事，用户会以为「权限都给了怎么还是读不到」而放弃。
+     */
+    fun isLocationEnabled(): Boolean = try {
+        val lm = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            lm.isLocationEnabled
+        } else {
+            lm.isProviderEnabled(LocationManager.GPS_PROVIDER)
+                || lm.isProviderEnabled(LocationManager.NETWORK_PROVIDER)
+        }
+    } catch (e: Throwable) {
+        false
+    }
+
+    /**
+     * 读「当前大概在哪」。返回 JSON：{lat, lon, accuracy, place}；
+     * 读不到返回空对象。place 为空串表示反查没成功——坐标仍然可用。
+     *
+     * 顺序：新鲜缓存 → 系统最后已知位置。缓存让这个方法能同步回答。
+     */
+    fun readJson(): JSONObject {
+        if (!hasAny()) return JSONObject()
+        if (!isLocationEnabled()) return JSONObject()
+
+        if (cachedJson.isNotEmpty() && System.currentTimeMillis() - cachedAt < CACHE_TTL_MS) {
+            return runCatching { JSONObject(cachedJson) }.getOrDefault(JSONObject())
+        }
+
+        val known = freshestLastKnown() ?: return JSONObject()
+        return cache(known)
+    }
+
+    /**
+     * 主动取一次实时位置（一次性，不是持续追踪）。
+     *
+     * 为什么需要它：「最后已知位置」可能是几小时前的，拿它说「到了公司」
+     * 就错了。取完结果落进缓存，之后 readJson() 就能读到。
+     * 有请求在进行时直接返回，不叠加。
+     */
+    fun refresh() {
+        if (!hasAny() || !isLocationEnabled()) return
+        if (fixing) return
+        fixing = true
+        lastError = ""
+
+        val lm = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+        val providers = ArrayList<String>()
+        // 优先融合定位（API 31+，更省电更准），退回网络/GPS。
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            providers.add(LocationManager.FUSED_PROVIDER)
+        }
+        runCatching {
+            if (lm.isProviderEnabled(LocationManager.NETWORK_PROVIDER)) {
+                providers.add(LocationManager.NETWORK_PROVIDER)
+            }
+        }
+        runCatching {
+            if (lm.isProviderEnabled(LocationManager.GPS_PROVIDER)) {
+                providers.add(LocationManager.GPS_PROVIDER)
+            }
+        }
+        if (providers.isEmpty()) {
+            fixing = false
+            lastError = "系统里没有可用的定位来源"
+            return
+        }
+
+        var settled = false
+        val settle: (Location?) -> Unit = { location ->
+            if (!settled) {
+                settled = true
+                fixing = false
+                if (location == null) {
+                    lastError = "这次没能取到位置"
+                } else {
+                    cache(location)
+                    fixCount += 1
+                    reverseGeocode(location)
+                }
+            }
+        }
+
+        val timeout = Runnable { settle(null) }
+        main.postDelayed(timeout, FIX_TIMEOUT_MS)
+
+        try {
+            val provider = providers.first()
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                lm.getCurrentLocation(
+                    provider,
+                    CancellationSignal(),
+                    ContextCompat.getMainExecutor(context),
+                ) { location ->
+                    main.removeCallbacks(timeout)
+                    settle(location)
+                }
+            } else {
+                @Suppress("DEPRECATION")
+                lm.requestSingleUpdate(
+                    provider,
+                    object : LocationListener {
+                        override fun onLocationChanged(location: Location) {
+                            main.removeCallbacks(timeout)
+                            settle(location)
+                        }
+
+                        override fun onStatusChanged(provider: String?, status: Int, extras: Bundle?) = Unit
+                        override fun onProviderEnabled(provider: String) = Unit
+                        override fun onProviderDisabled(provider: String) = Unit
+                    },
+                    Looper.getMainLooper(),
+                )
+            }
+        } catch (e: SecurityException) {
+            main.removeCallbacks(timeout)
+            lastError = "没有定位权限"
+            settle(null)
+        } catch (e: Throwable) {
+            main.removeCallbacks(timeout)
+            lastError = e.message ?: "取位置失败"
+            settle(null)
+        }
+    }
+
+    /** 从各 provider 的最后已知位置里挑最新的那个。都空则返回 null。 */
+    private fun freshestLastKnown(): Location? {
+        val lm = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+        val providers = listOf(
+            LocationManager.GPS_PROVIDER,
+            LocationManager.NETWORK_PROVIDER,
+            LocationManager.PASSIVE_PROVIDER,
+        )
+        var best: Location? = null
+        for (name in providers) {
+            val candidate = try {
+                if (lm.isProviderEnabled(name)) lm.getLastKnownLocation(name) else null
+            } catch (e: Throwable) {
+                null
+            } ?: continue
+            val current = best
+            if (current == null || candidate.time > current.time) best = candidate
+        }
+        return best
+    }
+
+    /**
+     * 把一次定位写进缓存（坐标降精度，保留已有地名）。
+     *
+     * 保留地名：refresh() 里先落坐标、再异步反查名字，若反查还没回来
+     * 就有一次 readJson()，此时至少坐标是新的，名字退而上一次那个
+     * （大概率仍是同一片区域，比空着更有用）。
+     */
+    private fun cache(location: Location): JSONObject {
+        val prevPlace = runCatching {
+            JSONObject(cachedJson).optString("place", "")
+        }.getOrDefault("")
+        val json = JSONObject()
+            .put("lat", roundTo(location.latitude))
+            .put("lon", roundTo(location.longitude))
+            .put("accuracy", location.accuracy.toInt())
+            .put("place", prevPlace)
+        cachedJson = json.toString()
+        cachedAt = System.currentTimeMillis()
+        return json
+    }
+
+    private fun roundTo(value: Double): Double {
+        val factor = Math.pow(10.0, COORD_DECIMALS.toDouble())
+        return round(value * factor) / factor
+    }
+
+    /**
+     * 坐标 → 粗粒度地名（区/街道一级）。
+     *
+     * 在后台线程做：Geocoder 是阻塞调用，放主线程会卡住浮层与网页。
+     * 失败或拿不到就静默放弃——地名只是「说人话」的装饰，坐标本身
+     * 仍然可用，不值得为它报错或重试。
+     *
+     * 刻意只取区/街道级名字，不取门牌、不取 POI 名。
+     */
+    private fun reverseGeocode(location: Location) {
+        if (!Geocoder.isPresent()) return
+        val targetLat = roundTo(location.latitude)
+        Thread {
+            val place = try {
+                @Suppress("DEPRECATION")
+                val list = Geocoder(context, Locale.getDefault())
+                    .getFromLocation(location.latitude, location.longitude, 1)
+                val address = list?.firstOrNull()
+                // 从细到粗试，取到第一个非空的：区 → 城市 → 县 → 省。
+                address?.subLocality
+                    ?: address?.locality
+                    ?: address?.subAdminArea
+                    ?: address?.adminArea
+                    ?: ""
+            } catch (e: Throwable) {
+                ""
+            }
+            if (place.isNotBlank()) {
+                // 只在坐标没被刷新过时才补名字，避免把旧地名贴到新坐标上
+                main.post {
+                    runCatching {
+                        val current = JSONObject(cachedJson)
+                        if (abs(current.optDouble("lat", 0.0) - targetLat) < 1e-6) {
+                            current.put("place", place)
+                            cachedJson = current.toString()
+                        }
+                    }
+                }
+            }
+        }.start()
+    }
+
+    /**
+     * 能力与授权状态。
+     *
+     * 三件事分开报，用户才知道卡在哪一环：
+     *   location          —— 这个壳版本能不能做（能）；
+     *   locationGranted   —— 用户给没给定位权限；
+     *   locationServiceOn —— 系统定位总开关有没有开着。
+     * 后两者任一为假都读不到，「权限给了但开关关着」最容易被漏掉。
+     */
+    fun capabilitiesJson(): String = JSONObject()
+        .put("location", true)
+        .put("locationGranted", hasAny())
+        .put("locationFineGranted", hasFine())
+        .put("locationServiceOn", isLocationEnabled())
+        .put("locationCached", cachedJson.isNotEmpty()
+            && System.currentTimeMillis() - cachedAt < CACHE_TTL_MS)
+        .toString()
+
+    /** 诊断面板用的内部状态（只含状态与计数，不含具体坐标）。 */
+    fun diagnosticsJson(): String = JSONObject()
+        .put("fixing", fixing)
+        .put("fixCount", fixCount)
+        .put("hasCache", cachedJson.isNotEmpty())
+        .put("cacheAgeMs", if (cachedAt > 0) System.currentTimeMillis() - cachedAt else -1)
+        .put("lastError", lastError)
+        .toString()
+}
diff --git a/android-shell/app/src/main/java/app/floatphone/shell/MainActivity.kt b/android-shell/app/src/main/java/app/floatphone/shell/MainActivity.kt
index a437ae3..cbbbeef 100644
--- a/android-shell/app/src/main/java/app/floatphone/shell/MainActivity.kt
+++ b/android-shell/app/src/main/java/app/floatphone/shell/MainActivity.kt
@@ -3,53 +3,132 @@ package app.floatphone.shell
 import android.Manifest
 import android.annotation.SuppressLint
 import android.app.DownloadManager
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.ContentValues
 import android.content.Context
 import android.content.Intent
 import android.content.pm.PackageManager
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
 import android.media.AudioManager
 import android.net.Uri
 import android.os.Build
