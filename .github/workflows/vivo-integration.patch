+                </div>
+            </div>
+
+            {/* ── 逐项自定义：默认收起，避免一屏全是取色器 ── */}
+            <div className="menu-group" style={{ marginTop: 10 }}>
+                <div className="menu-item" style={{ cursor: "default" }}>
+                    <div className="menu-label-group">
+                        <span className="menu-label">逐项调色</span>
