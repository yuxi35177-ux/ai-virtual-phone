--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/ScreenshotBallService.kt
@@ -0,0 +1,514 @@
+package app.floatphone.shell
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Color
+import android.graphics.PixelFormat
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.util.Base64
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import android.widget.TextView
+import androidx.core.app.NotificationCompat
+import org.json.JSONObject
+import java.io.File
+import kotlin.math.abs
+
+/**
+ * 截屏悬浮球：一个贴边的圆点，轻点一下就截当前屏。
+ *
+ * 为什么要有它——截屏的另一半动机：
+ *   「主动查岗」是角色想看你；但很多时候是**你自己**想给角色看点什么
+ *   （刚拼好的乐高、正在排队、路上遇到的猫）。没有悬浮球时，你只能先
+ *   进小手机、翻设置、点测试——等真截到时那个瞬间早过去了。
+ *
+ * 与查岗共用的部分：
+ *   点击后**不自己截**，而是把活交给 CheckInService（source=user）。
+ *   预览、审批、回复框、超时丢弃——整套都是同一份实现。这里只负责
+ *   「一个能拖动的圆点」和「把点击转成一次截屏请求」。
+ *
+ * 设计边界（改这个文件前先读）：
+ *  - **只在用户点它时才截**：没有定时、没有监听、不响应任何自动触发。
+ *  - 默认不显示：由网页在用户打开「截屏悬浮球」开关时拉起（此刻 App 在前台，
+ *    才能合法启动前台服务），关掉即收。
+ *  - 图仍然只在本机流转：真正的截屏与审批在 CheckInService，隐私约定与查岗完全一致。
+ */
+class ScreenshotBallService : Service() {
+
+    companion object {
+        private const val CH = "shell_screenshot_ball"
+        private const val NOTIF_ID = 5
+
+        private const val ACTION_PREPARE = "app.floatphone.shell.BALL_PREPARE"
+        private const val ACTION_STOP = "app.floatphone.shell.BALL_STOP"
+
+        private const val PREFS = "screenshot_ball_prefs"
+
+        /** 贴边留白。 */
+        private const val EDGE_DP = 6
+
+        /** 直径默认值（用户可在设置里改，32~96）。 */
+        private const val DEFAULT_DIAMETER_DP = 50
+
+        /** 外观默认值：蓝底白字「截」。 */
+        private const val DEFAULT_TEXT = "截"
+        private const val DEFAULT_COLOR = 0xE65B7CFA.toInt()
+
+        // ── 外观配置（由网页下发，落 SharedPreferences）──
+        //
+        // 为什么存盘而不是只放内存：球是原生画的，而用户改外观的那一刻
+        // 网页在前台；改完可能要过很久再重启 App（服务被系统拉起），
+        // 那时网页还没加载，只能读盘。
+
+        /** 球上的文字（空串 = 不显示文字，只画圆点）。 */
+        @Volatile
+        private var ballText: String = DEFAULT_TEXT
+
+        /** 球的主色。 */
+        @Volatile
+        private var ballColor: Int = DEFAULT_COLOR
+
+        /** 球直径（dp）。 */
+        @Volatile
+        private var ballDiameterDp: Int = DEFAULT_DIAMETER_DP
+
+        /** 自定义图片的落盘路径（空串 = 没有，用纯色圆点）。 */
+        @Volatile
+        private var ballImagePath: String = ""
+
+        /** 从盘里读一次外观配置。 */
+        private fun loadStyle(context: Context) {
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            ballText = prefs.getString("text", DEFAULT_TEXT) ?: DEFAULT_TEXT
+            ballColor = prefs.getInt("color", DEFAULT_COLOR)
+            ballDiameterDp = prefs.getInt("diameter", DEFAULT_DIAMETER_DP).coerceIn(32, 96)
+            // 图片路径也要校验文件还在：用户清过数据、或文件被系统清理时，
+            // 路径还留在盘上但文件没了——这时必须退回纯色，否则球会变成空白。
+            val savedImage = prefs.getString("image_path", "").orEmpty()
+            ballImagePath = if (savedImage.isNotEmpty() && File(savedImage).exists()) savedImage else ""
+        }
+
+        /**
+         * 下发外观并即时重画。参数形如 {"text","color","diameter","image"}。
+         *
+         * image 的语义：空串 = 清除自定义图片回到纯色；非空 = base64 PNG；
+         * **字段不存在 = 这次不改图片**。三者必须分开，否则「只改颜色」
+         * 会把用户上传的图弄丢。
+         */
+        fun setStyle(context: Context, json: String): Boolean = runCatching {
+            val obj = JSONObject(json)
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            val editor = prefs.edit()
+            if (obj.has("text")) {
+                val text = obj.optString("text", DEFAULT_TEXT).take(4)
+                ballText = text
+                editor.putString("text", text)
+            }
+            if (obj.has("color")) {
+                val parsed = parseColor(obj.optString("color", ""))
+                if (parsed != null) {
+                    ballColor = parsed
+                    editor.putInt("color", parsed)
+                }
+            }
+            if (obj.has("diameter")) {
+                val size = obj.optInt("diameter", DEFAULT_DIAMETER_DP).coerceIn(32, 96)
+                ballDiameterDp = size
+                editor.putInt("diameter", size)
+            }
+            if (obj.has("image")) {
+                val base64 = obj.optString("image", "")
+                if (base64.isEmpty()) {
+                    ballImagePath = ""
+                    editor.putString("image_path", "")
+                } else {
+                    // 落成文件而不是塞进 prefs：几十 KB 的 base64 放 prefs 里
+                    // 会让每次读写都变慢，而 prefs 是同步提交、会卡主线程。
+                    val target = File(context.filesDir, "screenshot_ball_custom.png")
+                    val saved = runCatching {
+                        target.writeBytes(Base64.decode(base64, Base64.DEFAULT))
+                        // 落盘后立刻验证能解码成图：解不出来就当没设，
+                        // 免得球变成一个空白方块
+                        BitmapFactory.decodeFile(target.absolutePath) != null
+                    }.getOrDefault(false)
+                    if (saved) {
+                        ballImagePath = target.absolutePath
+                        editor.putString("image_path", ballImagePath)
+                    }
+                }
+            }
+            editor.apply()
+            // 球正显示着就当场重画——改完能立刻看到效果，不用重开开关
+            liveInstance?.let { it.main.post { it.rebuildBall() } }
+            true
+        }.getOrDefault(false)
+
+        /** 读当前外观（设置页回显用）。 */
+        fun styleJson(context: Context): String {
+            loadStyle(context)
+            return JSONObject()
+                .put("text", ballText)
+                .put("color", colorToHex(ballColor))
+                .put("diameter", ballDiameterDp)
+                // 只报「有没有自定义图片」，不回图本身——设置页不需要
+                // 拿回几万字符的 base64，它自己那边还留着原图。
+                .put("hasImage", ballImagePath.isNotEmpty())
+                .toString()
+        }
+
+        /** #RRGGBB 或 #AARRGGBB → 颜色 int；解析不了返回 null（保持原色）。 */
+        private fun parseColor(raw: String): Int? {
+            val hex = raw.trim().removePrefix("#")
+            return runCatching {
+                when (hex.length) {
+                    6 -> (0xFF000000L or hex.toLong(16)).toInt()
+                    8 -> hex.toLong(16).toInt()
+                    else -> null
+                }
+            }.getOrNull()
+        }
+
+        /** 颜色 int → #AARRGGBB（带透明度，设置页回显用）。 */
+        private fun colorToHex(color: Int): String = "#%08X".format(color)
+
+        /** 超过这个位移（dp）就算拖动，不算点击。 */
+        private const val TAP_SLOP_DP = 8
+
+        @Volatile
+        private var running = false
+
+        @Volatile
+        private var liveInstance: ScreenshotBallService? = null
+
+        /** 浮窗权限是否已授予（与通话浮窗、查岗共用同一个系统权限）。 */
+        fun canDraw(context: Context): Boolean =
+            Build.VERSION.SDK_INT < 23 || android.provider.Settings.canDrawOverlays(context)
+
+        /**
+         * 拉起悬浮球。返回是否成功发起；false 多半是没给浮窗权限。
+         * 必须由网页在 App 前台时调用（Android 12+ 禁止后台启动前台服务）。
+         */
+        fun prepare(context: Context): Boolean {
+            if (!canDraw(context)) return false
+            return runCatching {
+                val intent = Intent(context, ScreenshotBallService::class.java).apply { action = ACTION_PREPARE }
+                if (Build.VERSION.SDK_INT >= 26) context.startForegroundService(intent)
+                else context.startService(intent)
+                true
+            }.getOrDefault(false)
+        }
+
+        /** 收掉悬浮球（用户关闭开关时调用）。 */
+        fun stop(context: Context) {
+            runCatching {
+                context.startService(
+                    Intent(context, ScreenshotBallService::class.java).apply { action = ACTION_STOP },
+                )
+            }
+        }
+
+        fun isRunning(): Boolean = running
+
+        /** 能力与状态快照，给设置面板显示三态。 */
+        fun capabilitiesJson(): String = JSONObject()
+            .put("supported", Build.VERSION.SDK_INT >= Build.VERSION_CODES.R)
+            .put("accessibilityOn", ScreenshotBridge.isAccessibilityOn())
+            .put("running", running)
+            .toString()
+    }
+
+    private val main = Handler(Looper.getMainLooper())
+    private lateinit var windowManager: WindowManager
+    private var ballView: View? = null
+
+    /** 当前位置（px，相对屏幕左上角）。 */
+    private var posX = 0
+    private var posY = 0
+    private var diameterPx = 0
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onCreate() {
+        super.onCreate()
+        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager
+        loadStyle(this)
+        diameterPx = dp(ballDiameterDp)
+        createChannel()
+        startForeground(NOTIF_ID, buildNotification())
+    }
+
+    /**
+     * 按当前外观重画球（用户改配置时调用）。
+     *
+     * 先拆再建而不是就地改属性：直径变了窗口尺寸也得变，
+     * 而窗口尺寸只能在 addView 时定，updateViewLayout 改不了大小。
+     */
+    private fun rebuildBall() {
+        ballView?.let { view -> runCatching { windowManager.removeView(view) } }
+        ballView = null
+        diameterPx = dp(ballDiameterDp)
+        showBall()
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        when (intent?.action) {
+            ACTION_PREPARE -> {
+                running = true
+                liveInstance = this
+                main.post { showBall() }
+            }
+            ACTION_STOP -> {
+                teardown()
+                return START_NOT_STICKY
+            }
+            // START_STICKY 被系统重新拉起时 intent 可能为 null：
+            // 照常把球挂回去，不然「被系统杀过一次就再也不出现」。
+            null -> {
+                running = true
+                liveInstance = this
+                main.post { showBall() }
+            }
+        }
+        return START_STICKY
+    }
+
+    override fun onDestroy() {
+        teardown()
+        super.onDestroy()
+    }
+
+    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
+
+    /**
+     * 读自定义图片并裁成圆形。没有图片、读失败都返回 null（调用方退回纯色）。
+     *
+     * 裁剪必须在这里做：直接把方图设成背景会露出四角，而球是个圆。
+     * 用 Canvas + SRC_IN 涂一遍是最省事的圆裁法——先把整个圆画成不透明，
+     * 再把图叠上去按 SRC_IN 混合，圆外的部分自然被切掉。
+     */
+    private fun loadBallImage(): Bitmap? {
+        val path = ballImagePath
+        if (path.isEmpty()) return null
+        return runCatching {
+            val source = BitmapFactory.decodeFile(path) ?: return null
+            val size = diameterPx.coerceAtLeast(1)
+            val output = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+            val canvas = android.graphics.Canvas(output)
+            val paint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
+            val rect = android.graphics.RectF(0f, 0f, size.toFloat(), size.toFloat())
+            paint.color = Color.WHITE
+            canvas.drawOval(rect, paint)
+            paint.xfermode = android.graphics.PorterDuffXfermode(android.graphics.PorterDuff.Mode.SRC_IN)
+            // 等比缩到正方形再画。非正方形的源图会被拉一下——
+            // 球就那么大，用户传的多半也是头像类方图，不值得为它做复杂裁切。
+            canvas.drawBitmap(Bitmap.createScaledBitmap(source, size, size, true), 0f, 0f, paint)
+            output
+        }.getOrNull()
+    }
+
+    private fun loadPosition() {
+        val prefs = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val screenW = resources.displayMetrics.widthPixels
+        val screenH = resources.displayMetrics.heightPixels
+        val savedX = prefs.getInt("x", -1)
+        val savedY = prefs.getInt("y", -1)
+        // 直径可能刚被改过，重新算一次，否则换大球时初始位置会偏出屏幕
+        diameterPx = dp(ballDiameterDp)
+        posX = if (savedX >= 0) savedX else screenW - diameterPx - dp(EDGE_DP)
+        posY = if (savedY >= 0) savedY else screenH / 3
+        clamp()
+    }
+
+    private fun clamp() {
+        val screenW = resources.displayMetrics.widthPixels
+        val screenH = resources.displayMetrics.heightPixels
+        posX = posX.coerceIn(0, maxOf(0, screenW - diameterPx))
+        posY = posY.coerceIn(0, maxOf(0, screenH - diameterPx))
+    }
+
+    private fun savePosition() {
+        runCatching {
+            getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                .putInt("x", posX).putInt("y", posY).apply()
+        }
+    }
+
+    private fun showBall() {
+        if (!canDraw(this)) return
+        if (ballView != null) return
+        loadStyle(this)
+        loadPosition()
+
+        // 有自定义图片就用图片当球面，否则用纯色圆点。
+        // 图片模式不显示文字——图上的内容才是主体，再叠个字只会糊成一团。
+        val customImage = loadBallImage()
+        val view = TextView(this).apply {
+            text = if (customImage != null) "" else ballText
+            setTextColor(Color.WHITE)
+            // 字号跟着直径走：球调大了字还是 16sp 会显得又小又空
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, (ballDiameterDp * 0.32f).coerceIn(12f, 28f))
+            gravity = Gravity.CENTER
+            background = if (customImage != null) {
+                BitmapDrawable(resources, customImage)
+            } else {
+                GradientDrawable().apply {
+                    shape = GradientDrawable.OVAL
+                    setColor(ballColor)
+                    setStroke(dp(2), 0x66FFFFFF)
+                }
+            }
+            // 让整块圆都吃触摸事件（否则只有文字那一小块能拖）
+            isClickable = true
+        }
+
+        var downRawX = 0f
+        var downRawY = 0f
+        var originX = 0
+        var originY = 0
+        var moved = false
+
+        view.setOnTouchListener { _, event ->
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downRawX = event.rawX
+                    downRawY = event.rawY
+                    originX = posX
+                    originY = posY
+                    moved = false
+                    true
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = event.rawX - downRawX
+                    val dy = event.rawY - downRawY
+                    if (!moved && abs(dx) + abs(dy) > dp(TAP_SLOP_DP)) moved = true
+                    if (moved) {
+                        posX = (originX + dx).toInt()
+                        posY = (originY + dy).toInt()
+                        clamp()
+                        applyPosition()
+                    }
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (moved) {
+                        // 松手贴边：吸到左或右，避免球停在屏幕正中间挡视线
+                        snapToEdge()
+                        savePosition()
+                    } else {
+                        onBallTapped()
+                    }
+                    true
+                }
+                else -> false
+            }
+        }
+
+        ballView = view
+        val params = buildLayoutParams()
+        runCatching { windowManager.addView(view, params) }
+    }
+
+    /** 松手后吸附到最近的左右边缘。 */
+    private fun snapToEdge() {
+        val screenW = resources.displayMetrics.widthPixels
+        posX = if (posX + diameterPx / 2 < screenW / 2) dp(EDGE_DP) else screenW - diameterPx - dp(EDGE_DP)
+        posY = posY.coerceIn(0, maxOf(0, resources.displayMetrics.heightPixels - diameterPx))
+        applyPosition()
+    }
+
+    private fun buildLayoutParams(): WindowManager.LayoutParams {
+        val type = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
+        } else {
+            @Suppress("DEPRECATION")
+            WindowManager.LayoutParams.TYPE_PHONE
+        }
+        return WindowManager.LayoutParams(
+            diameterPx,
+            diameterPx,
+            type,
+            // NOT_FOCUSABLE：不抢你正在用的 App 的输入焦点；
+            // NOT_TOUCH_MODAL：点到球以外的地方照常传给下面的 App。
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
+                or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            x = posX
+            y = posY
+        }
+    }
+
+    private fun applyPosition() {
+        val view = ballView ?: return
+        val params = (view.layoutParams as? WindowManager.LayoutParams) ?: return
+        params.x = posX
+        params.y = posY
+        runCatching { windowManager.updateViewLayout(view, params) }
+    }
+
+    /**
+     * 轻点球：交给 CheckInService 截屏并弹预览浮层。
+     *
+     * characterId 传空——「发给谁」等用户点完「发给它」由网页决定
+     * （取最近的私聊会话）。这样即便点击那一刻网页已被系统回收，
+     * 截屏与审批照样能进行，不会出现「点了球没反应」。
+     */
+    private fun onBallTapped() {
+        CheckInService.show(this, "", "", "", CheckInService.SOURCE_USER)
+    }
+
+    private fun createChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        runCatching {
+            getSystemService(NotificationManager::class.java).createNotificationChannel(
+                NotificationChannel(CH, "截屏悬浮球", NotificationManager.IMPORTANCE_MIN).apply {
+                    description = "桌面上那个点一下就能截屏的小圆点"
+                    setShowBadge(false)
+                },
+            )
+        }
+    }
+
+    /** 常驻通知做成静默：球本身已经在桌面上了，不该再刷一条通知。 */
+    private fun buildNotification(): android.app.Notification {
+        val open = PendingIntent.getActivity(
+            this, 91,
+            Intent(this, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        return NotificationCompat.Builder(this, CH)
+            .setSmallIcon(R.drawable.ic_stat)
+            .setContentTitle("小手机")
+            .setContentText("截屏悬浮球已开启")
+            .setOngoing(true)
+            .setSilent(true)
+            .setContentIntent(open)
+            .setPriority(NotificationCompat.PRIORITY_MIN)
+            .build()
+    }
+
+    private fun teardown() {
+        running = false
+        if (liveInstance === this) liveInstance = null
+        ballView?.let { view -> runCatching { windowManager.removeView(view) } }
+        ballView = null
+        stopForeground(true)
+        stopSelf()
+    }
+}
diff --git a/android-shell/app/src/main/java/app/floatphone/shell/ScreenshotBridge.kt b/android-shell/app/src/main/java/app/floatphone/shell/ScreenshotBridge.kt
new file mode 100644
index 0000000..97b93cc
--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/ScreenshotBridge.kt
@@ -0,0 +1,282 @@
+package app.floatphone.shell
+
+import android.accessibilityservice.AccessibilityService
+import android.graphics.Bitmap
+import android.os.Build
+import android.util.Base64
+import android.view.Display
+import org.json.JSONObject
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+
+/**
+ * 截屏桥：把用户此刻的真实屏幕画面交给网页（进而交给角色）。
+ *
+ * 为什么走无障碍服务而不是 MediaProjection：
+ *   MediaProjection 每次都要弹一个「开始录制或投射」的系统授权框，用户必须
+ *   手动确认再点一次——对一个「角色想看一眼你在干嘛」的轻动作来说代价太大。
+ *   Android 11 (API 30) 起 AccessibilityService.takeScreenshot() 可以在
+ *   **无障碍已授权的前提下直接取到画面**，代价是必须让用户先开无障碍服务
+ *   （本项目的通话浮窗保活本来就需要它，所以不算额外负担）。
+ *
+ * 设计边界（改这个文件前先读）：
+ *  - **不做隐蔽截屏**：只提供「调一次截一张」，没有定时、没有后台、没有监听。
+ *    截之前由网页侧明确提示用户，这里不替网页做任何判断。
+ *  - **只在本机流转**：原生只把画面交回网页，存不存、给不给角色看由网页决定
+ *    （见 lib/screenshot/），原生不上传任何地方。
+ *  - **失败必须说清**：取不到画面时如实返回原因（版本太低 / 无障碍没开 /
+ *    系统拒绝 / 太频繁），绝不返回一张空白图冒充成功。
+ *  - 结果是**异步**的：takeScreenshot 本身是回调式 API，所以 capture() 只回
+ *    「是否受理」，真正的画面经 ShellBus 的 'screenshot' 事件推回网页。
+ */
+object ScreenshotBridge {
+
+    /**
+     * 当前挂着的无障碍服务实例。CallControlService 连上/断开时在这里登记。
+     * 必须借它的实例——takeScreenshot() 是 AccessibilityService 的方法。
+     */
+    @Volatile
+    private var service: AccessibilityService? = null
+
+    /** 截屏进行中。takeScreenshot 有调用间隔限制，连点只会白白撞系统拒绝。 */
+    @Volatile
+    private var capturing = false
+
+    /** 回调线程：缩图与 PNG 编码不该占主线程。 */
+    private val executor: ExecutorService by lazy {
+        Executors.newSingleThreadExecutor { runnable ->
+            Thread(runnable, "screenshot-bridge").apply { isDaemon = true }
+        }
+    }
+
+    /**
+     * 输出画面的宽度上限（等比缩放，不裁剪）。
+     *
+     * 全屏原图在 1440 宽的手机上是数 MB 的 PNG，base64 还要再涨三分之一，
+     * 经 evaluateJavascript 推回网页时既慢又占内存；720 宽足够看清界面内容。
+     */
+    private const val MAX_WIDTH = 720
+
+    /** 由 CallControlService 调用：登记或注销可用实例。 */
+    fun attach(target: AccessibilityService?) {
+        service = target
+        // 服务断开时把进行中标志清掉，否则重连后第一次截屏会被误判成「上一张还没完」。
+        if (target == null) capturing = false
+    }
+
+    /** 能不能截。真正成不成还要看 takeScreenshot 的回调。 */
+    fun canCapture(): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.R && service != null
+
+    /** 无障碍服务是否已开（截屏的唯一前提）。 */
+    fun isAccessibilityOn(): Boolean = service != null
+
+    /** 能力与状态快照，给设置面板显示三态。 */
+    fun capabilitiesJson(): String = JSONObject()
+        .put("supported", Build.VERSION.SDK_INT >= Build.VERSION_CODES.R)
+        .put("accessibilityOn", service != null)
+        .put("ready", canCapture())
+        .toString()
+
+    // ── 诊断留痕 ────────────────────────────────────────────
+    //
+    // 截屏这条链路上「点了没反应」最难查：系统 API 全是回调式，失败分支又被
+    // 兜底吞掉，用户只看得到「什么都没发生」。这里把关键节点记下来，
+    // 设置页的诊断面板直接读，不必连 USB 调试。
+    //
+    // 只记状态与尺寸，**绝不记画面内容**——留痕里不会出现任何截图数据。
+
+    /** 最近一次失败原因（空串 = 没记到失败）。 */
+    @Volatile
+    private var lastError: String = ""
+
+    /** 最近一次截屏的时刻（毫秒）；0 = 从未截过。 */
+    @Volatile
+    private var lastCaptureAt: Long = 0L
+
+    /** 最近一次截屏是否成功。 */
+    @Volatile
+    private var lastCaptureOk: Boolean = false
+
+    /** 最近一次截屏的补充说明（成功记尺寸体积，失败记原因）。 */
+    @Volatile
+    private var lastCaptureNote: String = ""
+
+    /** 累计截屏次数（成功 + 失败）。 */
+    @Volatile
+    private var captureCount: Int = 0
+
+    private fun recordFailure(where: String, reason: String) {
+        lastError = "$where: $reason"
+        lastCaptureAt = System.currentTimeMillis()
+        lastCaptureOk = false
+        lastCaptureNote = reason
+        captureCount += 1
+    }
+
+    /** 诊断快照：截屏桥的内部状态，给设置页的「诊断」面板读。 */
+    fun diagnosticsJson(): String = JSONObject()
+        .put("supported", Build.VERSION.SDK_INT >= Build.VERSION_CODES.R)
+        .put("accessibilityOn", service != null)
+        .put("ready", canCapture())
+        .put("capturing", capturing)
+        .put("lastError", lastError)
+        .put("lastCaptureAt", lastCaptureAt)
+        .put("lastCaptureOk", lastCaptureOk)
+        .put("lastCaptureNote", lastCaptureNote)
+        .put("captureCount", captureCount)
+        .toString()
+
+    /**
+     * 发起一次截屏。
+     *
+     * @return `{"ok":true,"accepted":true}` 表示已经交给系统；
+     *         画面稍后经 ShellBus 的 'screenshot' 事件推回网页
+     *         （成功带 base64/width/height，失败带 reason）。
+     */
+    fun capture(): JSONObject {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            return fail("系统版本太低，截屏需要 Android 11 及以上")
+        }
+        if (service == null) return fail("无障碍服务没有开启，截屏无法进行")
+        if (capturing) return fail("上一张还没截完，请稍等一下")
+
+        captureBitmap { bitmap, error ->
+            if (bitmap == null) {
+                val reason = error ?: "截屏失败"
+                recordFailure("capture", reason)
+                publish(JSONObject().put("ok", false).put("reason", reason))
+                return@captureBitmap
+            }
+            encodeAndPublish(bitmap)
+        }
+        return JSONObject().put("ok", true).put("accepted", true)
+    }
+
+    /** 记住一次成功的截屏（尺寸与体积，不含画面）。 */
+    private fun recordSuccess(width: Int, height: Int, bytes: Int) {
+        lastCaptureAt = System.currentTimeMillis()
+        lastCaptureOk = true
+        lastCaptureNote = "${width}×${height} · ${bytes / 1024} KB"
+        captureCount += 1
+    }
+
+    /**
+     * 只取一张原始位图（已等比缩到 MAX_WIDTH 以内），交给调用方处置。
+     *
+     * 查岗浮层复用它：先拿到图给用户过目，用户点头才编码外发——
+     * 「不给」的那条路上，这张位图从头到尾没有变成过 base64。
+     *
+     * @param onResult 失败时 bitmap 为 null、error 为人话原因；可能同步回调。
+     */
+    fun captureBitmap(onResult: (Bitmap?, String?) -> Unit) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+            onResult(null, "系统版本太低，截屏需要 Android 11 及以上")
+            return
+        }
+        val svc = service
+        if (svc == null) {
+            onResult(null, "无障碍服务没有开启，截屏无法进行")
+            return
+        }
+        if (capturing) {
+            onResult(null, "上一张还没截完，请稍等一下")
+            return
+        }
+        capturing = true
+        try {
+            svc.takeScreenshot(
+                Display.DEFAULT_DISPLAY,
+                executor,
+                object : AccessibilityService.TakeScreenshotCallback {
+                    override fun onSuccess(result: AccessibilityService.ScreenshotResult) {
+                        capturing = false
+                        onResult(bitmapFrom(result), null)
+                    }
+
+                    override fun onFailure(errorCode: Int) {
+                        capturing = false
+                        onResult(null, failureReason(errorCode))
+                    }
+                },
+            )
+        } catch (e: Throwable) {
+            // 有些 ROM 把 takeScreenshot 收紧了，或无障碍被中途关掉；
+            // 如实回报，并且一定要把 capturing 标志放掉。
+            capturing = false
+            onResult(null, e.message ?: "发起截屏失败")
+        }
+    }
+
+    /** 把 ScreenshotResult 转成软件位图并等比缩小；失败返回 null。 */
+    private fun bitmapFrom(result: AccessibilityService.ScreenshotResult): Bitmap? {
+        val buffer = result.hardwareBuffer
+        return try {
+            // wrapHardwareBuffer 给的是 GPU 上的位图，缩放/编码前先复制成软件位图：
+            // hardware bitmap 上直接做缩放会抛异常。
+            val hardware = Bitmap.wrapHardwareBuffer(buffer, result.colorSpace) ?: return null
+            val software = hardware.copy(Bitmap.Config.ARGB_8888, false) ?: return null
+            scaleDown(software)
+        } catch (e: Throwable) {
+            null
+        } finally {
+            // HardwareBuffer 不关会一直占着图形内存，截几次就能把机器拖垮。
+            runCatching { buffer.close() }
+        }
+    }
+
+    /** 把位图编码成 PNG 并推回网页。 */
+    private fun encodeAndPublish(bitmap: Bitmap) {
+        try {
+            val png = ByteArrayOutputStream()
+            val bytes = try {
+                if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, png)) {
+                    publish(JSONObject().put("ok", false).put("reason", "无法编码屏幕画面"))
+                    return
+                }
+                png.toByteArray()
+            } finally {
+                runCatching { png.close() }
+            }
+            recordSuccess(bitmap.width, bitmap.height, bytes.size)
+            publish(
+                JSONObject()
+                    .put("ok", true)
+                    .put("width", bitmap.width)
+                    .put("height", bitmap.height)
+                    .put("bytes", bytes.size)
+                    .put("base64", Base64.encodeToString(bytes, Base64.NO_WRAP)),
+            )
+        } catch (e: Throwable) {
+            val reason = e.message ?: "处理屏幕画面失败"
+            recordFailure("encode", reason)
+            publish(JSONObject().put("ok", false).put("reason", reason))
+        }
+    }
+
+    /** 等比缩到 MAX_WIDTH 以内；本来就够小就原样返回。 */
+    private fun scaleDown(source: Bitmap): Bitmap {
+        if (source.width <= MAX_WIDTH) return source
+        val ratio = MAX_WIDTH.toFloat() / source.width
+        val height = (source.height * ratio).toInt().coerceAtLeast(1)
+        return Bitmap.createScaledBitmap(source, MAX_WIDTH, height, true)
+    }
+
+    /** 系统失败码 → 人话。绝不把错误码糊到用户脸上。 */
+    private fun failureReason(errorCode: Int): String = when (errorCode) {
+        AccessibilityService.ERROR_TAKE_SCREENSHOT_NO_ACCESSIBILITY_ACCESS ->
+            "系统拒绝了截屏：无障碍服务没有截屏权限"
+        AccessibilityService.ERROR_TAKE_SCREENSHOT_INTERVAL_TIME_SHORT ->
+            "截屏太频繁了，过一会儿再试"
+        AccessibilityService.ERROR_TAKE_SCREENSHOT_INVALID_DISPLAY ->
+            "屏幕不可用（可能正处在息屏或投屏切换中）"
+        else -> "截屏失败（错误码 $errorCode）"
+    }
+
+    private fun publish(payload: JSONObject) {
+        ShellBus.dispatchOverlayEvent("screenshot", payload)
+    }
+
+    private fun fail(reason: String): JSONObject = JSONObject().put("ok", false).put("reason", reason)
+}
diff --git a/android-shell/app/src/main/java/app/floatphone/shell/ShellBus.kt b/android-shell/app/src/main/java/app/floatphone/shell/ShellBus.kt
new file mode 100644
index 0000000..fea09a3
--- /dev/null
+++ b/android-shell/app/src/main/java/app/floatphone/shell/ShellBus.kt
@@ -0,0 +1,41 @@
+package app.floatphone.shell
+
+import android.webkit.WebView
+import org.json.JSONObject
+
+/**
+ * 壳 ↔ 网页的单向广播通道（原生 → 网页）。
+ *
+ * 通话浮窗、无障碍服务这些原生组件不在 MainActivity 里，需要主动把事件塞回网页。
+ * 这里持有当前 WebView 的引用（MainActivity 创建/销毁时登记），统一负责：
+ * - 把 JS 安全地投递到主线程执行（WebView 只能在主线程碰）；
+ * - 用 JSONObject.quote 生成合法 JS 字符串字面量（含引号/换行/反斜杠都能扛），
+ *   再交给页面 JSON.parse，避免手写字符串转义在角色名含引号时把脚本拼坏。
+ *
+ * 网页侧监听 window 上的 'shell-call-overlay' 事件，detail 形如
+ * { action: 'restore' | 'hangup' | 'reply' | 'tick', text?: string }。
+ */
+object ShellBus {
+
+    @Volatile
+    var webView: WebView? = null
+
+    /** 网页还活着吗（WebView 未销毁）。原生据此决定是走浮窗交互还是退化成通知。 */
+    fun isWebAlive(): Boolean = webView != null
+
+    /** 在主线程执行一段 JS。失败静默——原生侧不该因为网页异常而崩。 */
+    fun evalJs(script: String) {
+        val target = webView ?: return
+        target.post { runCatching { target.evaluateJavascript(script, null) } }
+    }
+
+    /**
+     * 向网页派发一个通话浮窗事件。
+     * @param action restore（点浮窗回全屏）/ hangup（挂断）/ reply（快捷回复）/ tick（心跳）
+     */
+    fun dispatchOverlayEvent(action: String, payload: JSONObject = JSONObject()) {
+        val detail = JSONObject(payload.toString()).put("action", action)
+        val literal = JSONObject.quote(detail.toString())
+        evalJs("window.dispatchEvent(new CustomEvent('shell-call-overlay',{detail:JSON.parse($literal)}))")
+    }
+}
