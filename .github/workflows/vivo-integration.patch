+      if (!Object.values(loadCheckInConfig()).some(item => item.enabled)) stopCheckInService();
+      return;
+    }
+    if (!inShell) { onNotice?.("当前不在小手机 App 内，查岗需要安卓壳"); return; }
+    if (!readiness.supported) { onNotice?.("系统版本太低，查岗需要 Android 11 及以上"); return; }
