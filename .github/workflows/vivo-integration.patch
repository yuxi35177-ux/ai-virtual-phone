+++ b/lib/widget/bridge.ts
@@ -0,0 +1,157 @@
+"use client";
+
+/**
+ * 小组件 ↔ 安卓壳的桥。
+ *
+ * 分工：
+ *   网页负责「内容和样式」——把模板渲染成完整 HTML 交给原生；
+ *   原生负责「画图和贴到桌面」——离屏 WebView 画成 Bitmap，再更新 RemoteViews。
+ *
+ * 为什么不让网页直接渲染成 PNG 再传：
+ *   WebView 的 canvas.toDataURL 拿不到跨域图片（生成的头像是 data URL 没问题，
+ *   但用户模板里若引了 http 图片就会污染画布）。交给原生离屏渲染没有这个限制，
+ *   而且小手机关着时原生也能自己重画（用上次缓存的 HTML）。
+ *
+ * 所有方法在非壳环境安全降级为 no-op / false。
+ */
+
+import { loadWidgetConfig } from "./storage";
+
+type PhoneWidgetBridge = {
+  /** 是否支持小组件（老 APK 没有） */
+  isSupported?: () => boolean;
+  /** 提交渲染数据：HTML + 尺寸。原生据此重画并刷新桌面 */
+  update?: (html: string, widthDp: number, heightDp: number, scale: number) => boolean;
+  /** 让原生立刻重画一次（用上次缓存的 HTML） */
+  refresh?: () => boolean;
+  /** 是否已添加小组件到桌面（未添加时引导用户去加） */
+  isPlaced?: () => boolean;
+  /** 跳到系统的「添加小组件」界面 */
+  requestPin?: () => boolean;
+  /**
+   * 小组件渲染诊断（**新壳才有**，旧壳没有这个方法）。
+   *
+   * 回传原生侧的实际状态：收到 HTML 没、PNG 有没有落盘、最后一次渲染成败。
+   * 网页侧读不到时返回 null——调用方据此说明「需要更新安卓壳才能看到这一项」，
+   * 而不是把它当成「一切正常」。
+   */
+  diagnostics?: () => string;
+};
+
+/** 新壳回传的小组件诊断。字段含义见原生 PhoneWidgetRenderer.diagnosticsJson。 */
+export type WidgetDiagnostics = {
+  hasHtml: boolean;
+  htmlChars: number;
+  pngExists: boolean;
+  pngBytes: number;
+  pngAt: number;
+  renderAt: number;
+  renderOk: boolean;
+  renderError: string;
+  rendering: boolean;
+  placed: boolean;
+};
+
+function getBridge(): PhoneWidgetBridge | null {
+  if (typeof window === "undefined") return null;
+  const api = (window as unknown as { PhoneWidget?: PhoneWidgetBridge }).PhoneWidget;
+  return api ?? null;
+}
+
+export function hasWidgetBridge(): boolean {
+  const bridge = getBridge();
+  if (!bridge) return false;
+  try {
+    return bridge.isSupported ? bridge.isSupported() === true : true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * 把一份渲染好的 HTML 交给原生。
+ *
+ * @returns 是否成功送达（非壳环境、老壳都返回 false）
+ */
+export function pushWidgetHtml(
+  html: string,
+  size: { widthDp: number; heightDp: number; scale: number },
+): boolean {
+  const bridge = getBridge();
+  if (!bridge?.update) return false;
+  try {
+    return bridge.update(html, size.widthDp, size.heightDp, size.scale) === true;
+  } catch {
+    return false;
+  }
+}
+
+/** 让原生用缓存重画（例如用户刚改了桌面主题）。 */
+export function refreshWidget(): boolean {
+  const bridge = getBridge();
+  if (!bridge?.refresh) return false;
+  try {
+    return bridge.refresh() === true;
+  } catch {
+    return false;
+  }
+}
+
+/** 小组件是否已经放在桌面上。 */
+export function isWidgetPlaced(): boolean {
+  const bridge = getBridge();
+  if (!bridge?.isPlaced) return false;
+  try {
+    return bridge.isPlaced() === true;
+  } catch {
+    return false;
+  }
+}
+
+/** 拉起系统的「添加小组件」引导。 */
+export function requestPinWidget(): boolean {
+  const bridge = getBridge();
+  if (!bridge?.requestPin) return false;
+  try {
+    return bridge.requestPin() === true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * 读原生侧的小组件诊断。旧壳没这个方法时返回 null。
+ *
+ * 为什么要这个：渲染失败原来是静默的，桌面只会退回应用图标，而设置页的预览
+ * 又是 iframe 自己画的（走不到原生）——两边都正常，只有桌面不对，用户和我们都
+ * 无从判断卡在哪一步。有了它才能把链路逐段对照着看。
+ */
+export function readWidgetDiagnostics(): WidgetDiagnostics | null {
+  const bridge = getBridge();
+  if (!bridge?.diagnostics) return null;
+  try {
+    const raw = bridge.diagnostics();
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as WidgetDiagnostics;
+    return parsed && typeof parsed === "object" ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * 把当前存储里的配置与数据推给原生。保存配置、角色改了内容之后都该调一次。
+ *
+ * @param html 已经渲染好的 HTML（调用方用 renderWidgetHtml 生成）
+ */
+export function syncWidgetToNative(html: string): boolean {
+  const config = loadWidgetConfig();
+  if (!config.enabled) return false;
+  // 不再要求「有内容」才推送：html 已经是渲染好的成品（没内容时调用方给的是
+  // 占位模板）。卡在这里会让小组件退回显示应用图标，而不是模板本身。
+  return pushWidgetHtml(html, {
+    widthDp: config.widthDp,
+    heightDp: config.heightDp,
+    scale: config.scale,
+  });
+}
diff --git a/lib/widget/engine.ts b/lib/widget/engine.ts
new file mode 100644
index 0000000..cd41c2c
--- /dev/null
+++ b/lib/widget/engine.ts
@@ -0,0 +1,146 @@
+"use client";
+
+/**
+ * 小组件的自动生成：让角色隔段时间自己换一句留在桌面上。
+ *
+ * 与「角色用工具写」的关系：
+ *   工具写入 = 角色在聊天中主动想到「我想在 TA 桌面留句话」；
+ *   自动生成 = 角色没跟用户说话时，也偶尔在桌面换个状态。
+ * 两者写的是同一份数据，后者只是多一个触发源。
+ *
+ * 默认关闭：这是角色**主动往用户桌面上放东西**，与「等它说话」不同，
+ * 该由用户明确开启。
+ */
+
+import { simpleLLMCall } from "../api-helpers";
+import { loadCharacters } from "../character-storage";
+import { loadApiConfigs, resolveAuxiliaryApiConfig, resolveUserIdentity } from "../settings-storage";
+import { appendCustomAppTimelineEntry } from "../custom-app-storage";
+import { loadWidgetAutoLastRun, loadWidgetConfig, loadWidgetData, markWidgetAutoRun, saveWidgetData } from "./storage";
+
+/**
+ * 小组件自己的时间线来源标识。
+ *
+ * 用来把「我在桌面留了句话」写进角色的短期记忆。
+ */
+const WIDGET_SOURCE = { id: "phone_widget", name: "桌面小组件" };
+import { canGenerateAvatar, generateWidgetAvatar } from "./avatar";
+import type { WidgetData } from "./types";
+
+/** 自动生成的一句话最大长度：桌面上放不下长文。 */
+const AUTO_TEXT_LIMIT = 60;
+
+/**
+ * 让角色生成一句适合放在桌面上的话。
+ *
+ * 提示词刻意约束得很短：这是桌面小组件，不是聊天——
+ * 长了显示不下，也太「表演」。要的是一句像随手写下的状态。
+ */
+async function generateLine(
+  characterName: string,
+  userName: string,
+  previous: WidgetData | null,
+): Promise<{ text: string; status: string } | null> {
+  const config = resolveAuxiliaryApiConfig("memorySummaryApiConfigId") ?? loadApiConfigs()[0];
+  if (!config) return null;
+
+  const avoid = previous?.text ? `\n（不要重复你上次写的那句：「${previous.text}」）` : "";
+  const result = await simpleLLMCall(config, [
+    {
+      role: "system",
+      content: [
+        `你是「${characterName}」，正在${userName}手机桌面的一块小地方留一句话。`,
+        "这句话会被 TA 在桌面上直接看到，是你不经意留下的状态。",
+        "要求：",
+        `1. 正文一句话，不超过 ${AUTO_TEXT_LIMIT} 字，口语、具体、有生活感；`,
+        "2. 不要像在发消息，不要称呼对方，不要问句——就是要像随手记下的一句；",
+        "3. 不要用引号包住整句，不要写「我说：」这类前缀。",
+        "只输出严格 JSON，不要任何额外文字：{\"text\":\"...\",\"status\":\"...\"}",
+        "status 是一个 2-5 字的当前状态，如「在想你」「刚睡醒」「有点困」。",
+      ].join("\n"),
+    },
+    { role: "user", content: `现在给 TA 留一句。${avoid}` },
+  ], { temperature: 0.9 });
+
+  const raw = (result.content ?? "").trim();
+  if (!raw) return null;
+  // 模型可能包了 ```json 围栏，剥掉再解析
+  const cleaned = raw.replace(/^```(?:json)?/i, "").replace(/```$/, "").trim();
+  try {
+    const parsed = JSON.parse(cleaned) as { text?: unknown; status?: unknown };
+    const text = String(parsed.text ?? "").trim().replace(/^["「]|["」]$/g, "").slice(0, AUTO_TEXT_LIMIT);
+    if (!text) return null;
+    return { text, status: String(parsed.status ?? "").trim().slice(0, 12) };
+  } catch {
+    // 解析失败：把整段当成正文兜底（总比什么都不留好），但限长
+    const text = cleaned.replace(/\s+/g, " ").slice(0, AUTO_TEXT_LIMIT);
+    return text ? { text, status: "" } : null;
+  }
+}
+
+/**
+ * 跑一次自动生成（如果到了间隔）。
+ *
+ * @returns 是否真的换了内容
+ */
+export async function runWidgetAutoGenerate(): Promise<boolean> {
+  const config = loadWidgetConfig();
+  if (!config.enabled || !config.autoEnabled) return false;
+  if (!config.characterId) return false;
+
+  const intervalMs = Math.max(1, config.autoIntervalHours) * 3600_000;
+  const last = loadWidgetAutoLastRun();
+  if (last > 0 && Date.now() - last < intervalMs) return false;
+
+  const character = loadCharacters().find(item => item.id === config.characterId);
+  if (!character) return false;
+
+  const userName = resolveUserIdentity(config.characterId)?.name || "用户";
+  try {
+    const line = await generateLine(character.name, userName, loadWidgetData());
+    if (!line) return false;
+    // 先记号，再写数据：生成可能要十几秒，期间不能被重复触发
+    markWidgetAutoRun();
+
+    // 配了生图且用户开了开关时，顺手换一张配当前状态的头像。
+    // 失败/没配都静默沿用旧头像——头像只是锦上添花，
+    // 绝不能因为它让「换一句话」这件事整体失败。
+    // 头像优先级：已生成/上次留下的 > 角色卡头像。
+    // 以前只带上一轮的 avatar，没开「状态头像」时永远是空 → 桌面只剩首字，
+    // 与角色卡里设的头像完全脱节（用户实报）。
+    let avatar = loadWidgetData()?.avatar || (character.avatar ?? "");
+    if (config.useGeneratedAvatar && canGenerateAvatar()) {
+      const generated = await generateWidgetAvatar(character, line.status, line.text);
+      if (generated) avatar = generated;
+    }
+
+    saveWidgetData({
+      characterId: character.id,
+      text: line.text,
+      status: line.status,
+      avatar,
+      updatedAt: new Date().toISOString(),
+      source: "auto",
+    });
+
+    // 同步进角色的短期记忆（时间线）：这件事花的是**同一次**生成，只是多记一笔。
+    //
+    // 为什么必须记：这句话是角色自己写的，它下次聊天时该记得。不记的话，
+    // 用户说「你昨天在桌面写的那句」，角色会一脸茫然——而那句话明明是它写的（实测反馈）。
+    // 写完不触发任何回复：时间线只是上下文，什么时候开口由对话本身决定。
+    try {
+      appendCustomAppTimelineEntry(WIDGET_SOURCE, {
+        characterId: character.id,
+        summary: `我在 TA 手机桌面留了一句：${line.text}`,
+        detail: line.status ? `当时的状态标签：${line.status}` : undefined,
+      });
+    } catch {
+      // 记时间线失败不该影响留话本身——话已经写进桌面了
+    }
+    return true;
+  } catch (err) {
+    console.warn("[Widget] 自动生成失败", err);
+    return false;
+  }
+}
+
