new file mode 100644
index 0000000..71e275b
--- /dev/null
+++ b/lib/perception/cloud-sync.ts
@@ -0,0 +1,108 @@
+"use client";
+
+// 感知快照的云端同步（默认关闭）。
+//
+// 为什么需要它：离线推送时角色是在云端被唤醒生成的，而感知数据在手机上，
+// 云端读不到。开启后把「聚合后的状态」同步上去，角色离线醒来时能知道
+// 用户离开前最后的处境（电量、网络、在用什么应用、走了多少步）。
+//
+// 隐私边界（刻意如此设计，改代码前先读）：
+//   1. 只传聚合快照，不传原始采样流、不传应用全列表；
+//   2. 前台应用只传显示名，不传包名；
+//   3. 复用用户自建的云通道（自部署 Supabase），不经第三方；
+//   4. 默认关闭，开关与「传了什么」都可在现实桥面板里查看；
+//   5. 一键可清。
+
+import { bridgeConnection } from "../reality-bridge/storage";
+import { putObject, removeObject } from "../cloud-backup/storage-client";
+import { loadPerceptionConfig, loadPerceptionStatus } from "./storage";
+import { describeStatus, filterStatusBySwitches } from "./describe";
+
+/** 云端快照的存储路径（与快捷指令的 bridge-state 同目录，便于统一清理）。 */
+export const PERCEPTION_CLOUD_PATH = "bridge-state/perception.json";
+
+/** 云端存的最小载荷。字段少是刻意的——多一个字段就多一份泄漏面。 */
+export type PerceptionCloudPayload = {
+  /** 写入时刻 */
+  at: string;
+  /** 已格式化的一行状态速写（云端直接注入，不需要理解结构） */
+  summary: string;
+  /** 电量百分比，-1 = 未知 */
+  batteryPercent: number;
+  charging: boolean;
+  /** 当前前台应用显示名 */
+  foregroundApp: string;
+  /** 当天步数，-1 = 未知 */
+  steps: number;
+};
+
+/** 构造要上传的载荷。未采样过时返回 null。 */
+export function buildCloudPayload(): PerceptionCloudPayload | null {
+  const status = loadPerceptionStatus();
+  if (!status.at) return null;
+  // 必须过开关过滤。云端同步是状态快照的第三条消费路径（另外两条是
+  // 聊天注入与角色主动查询），漏掉它就等于「关了位置/睡眠开关，
+  // 这两个字段仍会被写进 summary 传到云端」——开关就形同虚设了。
+  const summary = describeStatus(filterStatusBySwitches(status, loadPerceptionConfig()));
+  if (!summary) return null;
+  return {
+    at: status.at,
+    summary,
+    batteryPercent: status.batteryPercent,
+    charging: status.charging,
+    foregroundApp: status.foregroundApp,
+    steps: status.steps,
+  };
+}
+
+/**
+ * 把当前快照推到云端。
+ *
+ * 未开启、未配置云端、无数据时静默跳过（返回 false）。
+ * 刻意不抛错：感知是后台能力，同步失败不该影响聊天。
+ */
+export async function syncPerceptionToCloud(): Promise<boolean> {
+  if (typeof window === "undefined") return false;
+  if (!loadPerceptionConfig().cloudSyncEnabled) return false;
+  const { config, ready } = bridgeConnection();
+  if (!ready) return false;
+  const payload = buildCloudPayload();
+  if (!payload) return false;
+  try {
+    await putObject(config, PERCEPTION_CLOUD_PATH, JSON.stringify(payload), "application/json");
+    return true;
+  } catch (err) {
+    console.warn("[感知] 云端同步失败", err);
+    return false;
+  }
+}
+
+/**
+ * 取一段「离线时可用」的本机状态描述。
+ *
+ * 用于本机在离线快照组装时补一句背景。数据过旧（> 6 小时）时不返回——
+ * 宁可不说，也不让角色拿一份半天前的电量当真。
+ */
+export function readLocalStatusForOffline(): string {
+  const status = loadPerceptionStatus();
+  if (!status.at) return "";
+  const ms = Date.now() - new Date(status.at).getTime();
+  if (!Number.isFinite(ms) || ms > 6 * 60 * 60 * 1000) return "";
+  // 与云端同步同理：这段文字会进离线快照，也必须尊重用户的关闭开关。
+  const summary = describeStatus(filterStatusBySwitches(status, loadPerceptionConfig()));
+  if (!summary) return "";
+  return `你上次留意到 TA 手机的状态：${summary}。`;
+}
+
+/** 清除云端快照（用户点「清除云端感知数据」时调用）。 */
+export async function clearCloudStatus(): Promise<boolean> {
+  const { config, ready } = bridgeConnection();
+  if (!ready) return false;
+  try {
+    await removeObject(config, PERCEPTION_CLOUD_PATH);
+    return true;
+  } catch (err) {
+    console.warn("[感知] 清除云端快照失败", err);
+    return false;
+  }
+}
diff --git a/lib/perception/describe.ts b/lib/perception/describe.ts
new file mode 100644
index 0000000..c6a28e2
--- /dev/null
+++ b/lib/perception/describe.ts
@@ -0,0 +1,227 @@
+"use client";
+
+// 设备状态 → 人话。
+//
+// 三个消费方（聊天注入 / 角色主动查询 / 云端快照）必须用同一份文案，
+// 否则角色在不同场景下对同一份数据会有不同理解，用户也难对照排查。
+// 所以格式化只做一遍，放在这里。
+
+import type { PerceptionConfig, PerceptionStatusSnapshot } from "./types";
+import { isCapabilityEnabled, loadPerceptionConfig, loadPerceptionStatus } from "./storage";
+
+/** 距某个时刻过去了多久，用人话讲。 */
+export function formatSince(at: string): string {
+  if (!at) return "";
+  const ms = Date.now() - new Date(at).getTime();
+  if (!Number.isFinite(ms) || ms < 0) return "";
+  const min = Math.floor(ms / 60000);
+  if (min < 1) return "刚刚";
+  if (min < 60) return `${min} 分钟前`;
+  const hour = Math.floor(min / 60);
+  if (hour < 24) return `${hour} 小时前`;
+  return `${Math.floor(hour / 24)} 天前`;
+}
+
+/**
+ * 把「最近一觉」说成人话。
+ *
+ * 说「昨晚睡了 7 小时 20 分钟」这种顺口的句子，不写「睡眠时长：440min」。
+ * 分辨昨晚还是今天小睡，只看入睡时刻是不是在今天零点之前——
+ * 这个量级够用，精确到几点几分入睡没必要（那属于作息细节）。
+ */
+function describeSleep(sleep: PerceptionStatusSnapshot["sleep"]): string {
+  if (!sleep || sleep.minutes <= 0) return "";
+  // 少于 30 分钟的多半是设备误记（手环压到、午间打盹没记全），提了是噪声
+  if (sleep.minutes < 30) return "";
+  const hours = Math.floor(sleep.minutes / 60);
+  const mins = sleep.minutes % 60;
+  const duration = hours > 0
+    ? (mins > 0 ? `${hours} 小时 ${mins} 分钟` : `${hours} 小时`)
+    : `${mins} 分钟`;
+  const startOfToday = new Date();
+  startOfToday.setHours(0, 0, 0, 0);
+  const isNight = sleep.startAt > 0 && sleep.startAt < startOfToday.getTime();
+  return isNight ? `昨晚睡了 ${duration}` : `今天睡了 ${duration}`;
+}
+
+/** 把网络类型说成人话。 */
+function describeNetwork(type: string, metered: boolean): string {
+  if (!type || type === "none") return "";
+  if (type === "wifi") return "连着 WiFi";
+  if (type === "cellular") return metered ? "在用移动网络" : "在用移动网络（不计费）";
+  return `网络：${type}`;
+}
+
+/**
+ * 把「今天用得最久的几个应用」说成人话。
+ *
+ * 三条取舍：
+ *  · 只说前 3 个——全列出来会变成屏幕使用报告；
+ *  · 少于 10 分钟的不提——那种多半是系统组件，提了是噪声；
+ *  · 说成「今天在微信 43 分钟」这种顺口的话，
+ *    不写「应用使用时长统计：微信 43min」这种报表腔。
+ */
+function describeTopUsage(appUsage: PerceptionStatusSnapshot["appUsage"]): string {
+  if (!appUsage || appUsage.length === 0) return "";
+  const top = appUsage.filter(item => item.minutes >= 10).slice(0, 3);
+  if (top.length === 0) return "";
+  const text = top
+    .map(item => `${item.label || item.package} ${item.minutes} 分钟`)
+    .join("、");
+  return `今天在 ${text}`;
+}
+
+/**
+ * 生成一段设备状态速写。
+ *
+ * 原则：有则说、无则不说。读不到的项直接省略，绝不写「未知」——
+ * 角色会把「未知」当成一句可供评论的信息，反而变成噪音。
+ */
+export function describeStatus(status: PerceptionStatusSnapshot): string {
+  const parts: string[] = [];
+
+  if (status.batteryPercent >= 0) {
+    parts.push(status.charging
+      ? `电量 ${status.batteryPercent}%（充电中）`
+      : `电量 ${status.batteryPercent}%`);
+  }
+
+  const net = describeNetwork(status.networkType, status.metered);
+  if (net) parts.push(net);
+
+  if (status.foregroundApp) {
+    parts.push(status.foregroundMinutes >= 1
+      ? `正在用${status.foregroundApp}（已 ${status.foregroundMinutes} 分钟）`
+      : `正在用${status.foregroundApp}`);
+  }
+
+  if (status.steps >= 0) parts.push(`今天走了 ${status.steps} 步`);
+
+  // 睡眠：只说时长，不说分期、不说几点睡的（那会暴露作息细节）。
+  const slept = describeSleep(status.sleep);
+  if (slept) parts.push(slept);
+
+  // 使用统计：只说前三个用得最久的，且只在超过一定时长时提。
+  // 一次把十几项全念出来，角色会变成一块屏幕使用报告，而不是「瞥了一眼」。
+  const usage = describeTopUsage(status.appUsage);
+  if (usage) parts.push(usage);
+
+  if (parts.length === 0) return "";
+  const age = formatSince(status.at);
+  return parts.join("，") + (age ? `（数据来自${age}）` : "");
+}
+
+/**
+ * 按用户的逐能力开关过滤状态。
+ *
+ * 关键：用户关掉「位置」不只是不想收到通知，也是不想让角色看见。
+ * 所以**每一条**读状态的路径都必须过这道过滤，把关闭项清空，而不是
+ * 原样返回——否则开关就形同虚设。目前有三条：聊天注入、角色主动查询、
+ * 云端同步（含离线快照的本机注入）。
+ */
+export function filterStatusBySwitches(
+  status: PerceptionStatusSnapshot,
+  config: PerceptionConfig,
+): PerceptionStatusSnapshot {
+  const out: PerceptionStatusSnapshot = { ...status };
+  if (!isCapabilityEnabled(config, "battery")) {
+    out.batteryPercent = -1;
+    out.charging = false;
+  }
+  if (!isCapabilityEnabled(config, "network")) {
+    out.networkType = "";
+    out.metered = false;
+  }
+  if (!isCapabilityEnabled(config, "foregroundApp")) {
+    out.foregroundApp = "";
+    out.foregroundMinutes = 0;
+  }
+  if (!isCapabilityEnabled(config, "steps")) {
+    out.steps = -1;
+  }
+  if (!isCapabilityEnabled(config, "usageStats")) {
+    out.appUsage = [];
+  }
+  if (!isCapabilityEnabled(config, "location")) {
+    out.location = null;
+  }
+  if (!isCapabilityEnabled(config, "sleep")) {
+    out.sleep = null;
+  }
+  return out;
+}
+
+/**
+ * 在线聊天时的状态注入文案。
+ *
+ * 默认关（injectStatus=false）：每轮都塞几十字会持续吃 token，
+ * 用户明确要了才开。关着或没数据时返回空串，调用方无需分支。
+ */
+export function maybeBuildStatusInjection(): string {
+  const config = loadPerceptionConfig();
+  if (!config.enabled || !config.injectStatus) return "";
+  const status = filterStatusBySwitches(loadPerceptionStatus(), config);
+  return buildStatusInjection(status);
+}
+
+/**
+ * 按关注点取一部分状态。
+ *
+ * 角色可能只想确认一件事（比如「TA 睡了吗」只关心是不是深夜还在用手机），
+ * 这时不该把全部信息丢回去——多出来的部分它会忍不住逐项评论，反而像个仪表盘。
+ * focus 为空或认不出时返回完整状态。
+ */
+export function describeStatusByFocus(status: PerceptionStatusSnapshot, focus?: string): string {
+  const key = (focus || "").trim().toLowerCase();
+  if (!key) return describeStatus(status);
+
+  const parts: string[] = [];
+  if (key === "battery" || key === "电量") {
+    if (status.batteryPercent >= 0) {
+      parts.push(status.charging ? `电量 ${status.batteryPercent}%（充电中）` : `电量 ${status.batteryPercent}%`);
+    }
+  } else if (key === "network" || key === "网络") {
+    const net = describeNetwork(status.networkType, status.metered);
+    if (net) parts.push(net);
+  } else if (key === "app" || key === "应用") {
+    if (status.foregroundApp) {
+      parts.push(status.foregroundMinutes >= 1
+        ? `正在用${status.foregroundApp}（已 ${status.foregroundMinutes} 分钟）`
+        : `正在用${status.foregroundApp}`);
+    }
+  } else if (key === "steps" || key === "步数") {
+    if (status.steps >= 0) parts.push(`今天走了 ${status.steps} 步`);
+  } else if (key === "sleep" || key === "睡眠" || key === "睡") {
+    const slept = describeSleep(status.sleep);
+    if (slept) parts.push(slept);
+  } else if (key === "usage" || key === "usageStats" || key === "使用时长" || key === "屏幕使用时间") {
+    const usage = describeTopUsage(status.appUsage);
+    if (usage) parts.push(usage);
+  } else if (key === "location" || key === "位置" || key === "地点") {
+    if (status.location?.place) parts.push(`现在在${status.location.place}附近`);
+  } else {
+    return describeStatus(status);
+  }
+
+  if (parts.length === 0) return "";
+  const age = formatSince(status.at);
+  return parts.join("，") + (age ? `（数据来自${age}）` : "");
+}
+
+/**
+ * 聊天上下文的注入文案。刻意用括号 + 「你注意到」的口吻，
+ * 让角色把状态当成背景感知而不是一条要回应的消息。
+ * 数据过旧（超过 30 分钟）时不注入，宁可不说也不要让角色说错。
+ */
+export function buildStatusInjection(status: PerceptionStatusSnapshot): string {
+  const ms = Date.now() - new Date(status.at).getTime();
+  if (!status.at || !Number.isFinite(ms) || ms > 30 * 60 * 1000) return "";
+  const text = describeStatus(status);
+  if (!text) return "";
+
+  const now = new Date();
+  const hh = String(now.getHours()).padStart(2, "0");
+  const mm = String(now.getMinutes()).padStart(2, "0");
+  return `（此刻是 ${hh}:${mm}。你顺手注意到对方手机的状态：${text}。`
+    + "这是背景信息，不用刻意提起，也别逐项复述；只在自然的时候顺口带一句。）";
+}
diff --git a/lib/perception/diagnostics.ts b/lib/perception/diagnostics.ts
new file mode 100644
index 0000000..fc95508
--- /dev/null
+++ b/lib/perception/diagnostics.ts
@@ -0,0 +1,162 @@
+"use client";
+
+// 感知系统的诊断与可视化数据源。
+// 设置面板「感知 → 诊断」直接消费这里，不需要自己拼装。
+
+import { isWithinPushQuietHours } from "../push-client";
+import {
+  hasPerceptionBridge,
+  readHealthCapabilities,
+  readHealthDiagnostics,
+  readLocation,
+  readLocationDiagnostics,
+  readNativeCapabilities,
+  readSleep,
+  readUsageStats,
+} from "./bridge";
+import { isPerceptionRunning } from "./engine";
+import { isCapabilityEnabled, loadPerceptionConfig, loadPerceptionState, loadPerceptionStatus } from "./storage";
+import {
+  PERCEPTION_CAPABILITY_DESC,
+  PERCEPTION_CAPABILITY_LABEL,
+  type PerceptionCapability,
+  type PerceptionDiagnostics,
+} from "./types";
+
+/** 本机当天日期键（YYYY-MM-DD）。与引擎里同名函数保持一致，用于判断档位是不是今天的。 */
+function todayKey(): string {
+  const d = new Date();
+  const p2 = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
+}
+
+/** 一次取全诊断状态。面板每次打开/刷新时调，不做缓存。 */
+export function readPerceptionDiagnostics(): PerceptionDiagnostics {
+  let accessibility = false;
+  try {
+    const bridge = (window as unknown as { AndroidShell?: { isAccessibilityConnected?: () => boolean } }).AndroidShell;
+    accessibility = bridge?.isAccessibilityConnected?.() === true;
+  } catch {
+    accessibility = false;
+  }
+
+  const state = loadPerceptionState();
+  const config = loadPerceptionConfig();
+  const now = Date.now();
+  const windowFresh = state.hourWindowStart > 0 && now - state.hourWindowStart < 60 * 60 * 1000;
+
+  return {
+    inShell: typeof window !== "undefined" && !!(window as unknown as { AndroidShell?: unknown }).AndroidShell,
+    bridgeAvailable: hasPerceptionBridge(),
+    running: isPerceptionRunning(),
+    nativeCapabilities: readNativeCapabilities(),
+    accessibility,
+    lastSampleAt: state.lastSampleAt,
+    lastSnapshot: state.lastSnapshot,
+    status: loadPerceptionStatus(),
+    appUsage: readUsageStats(12),
+    // 位置读数：这一行曾在本批编辑中误删，导致面板位置信息恒为空。别删。
+    location: readLocation(),
+    locationDiagnostics: readLocationDiagnostics(),
+    sleep: readSleep(),
+    healthDiagnostics: readHealthDiagnostics(),
+    hourlyUsed: windowFresh ? state.hourCount : 0,
+    hourlyLimit: config.hourlyLimit,
+    unmatchedSignals: state.unmatchedSignals,
+    usageSignalTier: state.usageSignalDate === todayKey() ? state.usageSignalTier : {},
+  };
+}
+
+/** 诊断面板里每个能力一行的展示模型。 */
+export type CapabilityRow = {
+  id: PerceptionCapability;
+  label: string;
+  desc: string;
+  /** 用户是否开启了这个能力 */
+  userEnabled: boolean;
+  /** 壳是否真的支持（原生如实回答） */
+  nativeSupported: boolean;
+  /** 是否有额外前置条件没满足（如无障碍未开） */
+  missingRequirement: string;
+  /** 综合可用性：userEnabled && nativeSupported && 无缺失前置 */
+  available: boolean;
+};
+
+/**
+ * 组装「能力可用性」表。
+ *
+ * 这是本次审计的直接产物：三项分开显示（用户开了没 / 原生支持没 / 前置条件够没），
+ * 用户一眼看出卡在哪一环，而不是面对一个没反应的开关。
+ */
+export function buildCapabilityRows(): CapabilityRow[] {
+  const config = loadPerceptionConfig();
+  const native = readNativeCapabilities();
+  let accessibility = false;
+  try {
+    const bridge = (window as unknown as { AndroidShell?: { isAccessibilityConnected?: () => boolean } }).AndroidShell;
+    accessibility = bridge?.isAccessibilityConnected?.() === true;
+  } catch {
+    accessibility = false;
+  }
+
+  // 睡眠的前置条件在健康桥那边（装没装 Health Connect、授没授权），
+  // 不在感知桥的能力表里，所以单独读一次。
+  const health = readHealthCapabilities();
+
+  const ids: PerceptionCapability[] = [
+    "battery", "network", "foregroundApp", "steps", "location", "sleep", "calendar", "contacts", "usageStats", "returnToPhone", "lifeRhythm",
+  ];
+
+  return ids.map(id => {
+    const userEnabled = isCapabilityEnabled(config, id);
+    // 这两个是纯网页实现（前后台计时 / 读时钟），不依赖原生桥，恒为支持。
+    // 不特殊处理的话，非壳环境/老 APK 下会被 native[id]===true 判成「不支持」，
+    // 而它们其实能用——比不显示更让人迷惑。
+    const pureWeb: PerceptionCapability[] = ["returnToPhone", "lifeRhythm"];
+    const nativeSupported = pureWeb.includes(id) ? true : native[id] === true;
+    let missingRequirement = "";
+    if (id === "foregroundApp" && nativeSupported && !accessibility) {
+      missingRequirement = "需要开启无障碍服务";
+    }
+    if (id === "steps" && !nativeSupported) {
+      missingRequirement = "需要重编 APK（当前壳版本未提供步数）";
+    }
+    // 使用统计：能力已接通，但需要特殊权限（去系统设置手动开），卡在这一环
+    if (id === "usageStats" && nativeSupported && native.usageStatsGranted !== true) {
+      missingRequirement = "需要「使用情况访问」权限（系统设置里手动开）";
+    }
+    // 定位：两层前置，且必须分开报——「权限给了但定位开关关着」是最容易
+    // 被漏掉的一种（用户会以为权限都给了怎么还读不到）。
+    if (id === "location" && nativeSupported) {
+      if (native.locationGranted !== true) {
+        missingRequirement = "需要位置权限";
+      } else if (native.locationServiceOn !== true) {
+        missingRequirement = "系统定位开关没开";
+      }
+    }
+    // 睡眠：三层前置，逐个报清楚，否则用户只会看到「开了却没反应」。
+    // 顺序按可操作性排：先装（没装就得去装），再授权。
+    if (id === "sleep" && nativeSupported) {
+      if (health.healthAvailable !== true) {
+        missingRequirement = "需要先安装 Health Connect";
+      } else if (health.healthGranted !== true) {
+        missingRequirement = "需要授予睡眠读取权限";
+      }
+    }
+    return {
+      id,
+      label: PERCEPTION_CAPABILITY_LABEL[id],
+      desc: PERCEPTION_CAPABILITY_DESC[id],
+      userEnabled,
+      nativeSupported,
+      missingRequirement,
+      available: userEnabled && nativeSupported && !missingRequirement,
+    };
+  });
+}
+
+/** 安静时段是否正在生效（面板给一条轻提示）。 */
+export function isQuietHoursActive(): boolean {
+  const config = loadPerceptionConfig();
+  return config.respectQuietHours && isWithinPushQuietHours(Date.now());
+}
