+            .setSmallIcon(R.drawable.ic_stat)
+            .setContentTitle(charName.ifBlank { "通话进行中" })
+            .setContentText(if (metaText.isBlank()) "点按返回小手机" else "$metaText · 点按返回小手机")
+            .setOngoing(true)
+            .setContentIntent(back)
