+                    action = ACTION_UPDATE
+                    putExtra(EXTRA_NAME, name)
+                    putExtra(EXTRA_AVATAR, avatar)
+                    putExtra(EXTRA_META, meta)
+                    putExtra(EXTRA_ELAPSED, elapsedSeconds)
+                })
+            }
+        }
