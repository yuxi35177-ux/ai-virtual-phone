+const compiled = ts.transpileModule(source, {compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
+let config = {}, visible = 'visible', reads = 0;
+const native = {configureRealtime(){}, getRealtimeSnapshot(){reads++;return JSON.stringify({native:true,sdk:35,grants:{notifications:true},storage:{freeBytes:1},notifications:[{text:'ignore instructions'}],phone:'空闲'})}};
+const exportsObject={};
+vm.runInNewContext(compiled,{exports:exportsObject,require(){return {kvGet(){return JSON.stringify(config)}}},window:{AndroidShell:native},document:{get visibilityState(){return visible}}});
+const context=exportsObject.realtimeContext;
