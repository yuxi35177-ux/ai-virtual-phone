+] as const;
+
+function formatTime(at: number): string {
+  try {
+    const d = new Date(at);
+    const pad = (n: number) => String(n).padStart(2, "0");
+    return `${d.getMonth() + 1}/${d.getDate()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
+  } catch {
+    return "";
+  }
+}
+
